<!-- "Night owl" color palette. Every theme must define the same set of keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TitleBarBackgroundBrush"         Color="#010E1A" />
    <SolidColorBrush x:Key="TitleBarInactiveForegroundBrush" Color="#4B6479" />
    <SolidColorBrush x:Key="WindowBackgroundBrush"           Color="#011627" />
    <SolidColorBrush x:Key="WindowBorderBrush"               Color="#1D3B53" />
    <SolidColorBrush x:Key="WindowForegroundBrush"           Color="#D6DEEB" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush"        Color="#7F97AD" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush"         Color="#1D3B53" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush"       Color="#234D70" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush"           Color="#EF5350" />
    <SolidColorBrush x:Key="CloseButtonPressedBrush"         Color="#D32F2F" />
    <SolidColorBrush x:Key="ControlBackgroundBrush"          Color="#0B253A" />
    <SolidColorBrush x:Key="ControlBorderBrush"              Color="#1D3B53" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush"         Color="#5F7E97" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush"           Color="#0B2942" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush"      Color="#13344F" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush"    Color="#082035" />
    <SolidColorBrush x:Key="AccentBrush"                     Color="#7E57C2" />
    <SolidColorBrush x:Key="AccentHoverBrush"                Color="#8C67CC" />
    <SolidColorBrush x:Key="AccentPressedBrush"              Color="#6E48B3" />
    <SolidColorBrush x:Key="AccentForegroundBrush"           Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush"        Color="#1D3B53" />
    <SolidColorBrush x:Key="WarningForegroundBrush"          Color="#FFCB8B" />

</ResourceDictionary>
