<!-- "Default night" color palette. Every theme must define the same set of keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="TitleBarBackgroundBrush"         Color="#1F1F1F" />
    <SolidColorBrush x:Key="TitleBarInactiveForegroundBrush" Color="#7A7A7A" />
    <SolidColorBrush x:Key="WindowBackgroundBrush"           Color="#2B2B2B" />
    <SolidColorBrush x:Key="WindowBorderBrush"               Color="#3C3C3C" />
    <SolidColorBrush x:Key="WindowForegroundBrush"           Color="#E6E6E6" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush"        Color="#A0A0A0" />
    <SolidColorBrush x:Key="CaptionButtonHoverBrush"         Color="#33FFFFFF" />
    <SolidColorBrush x:Key="CaptionButtonPressedBrush"       Color="#22FFFFFF" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush"           Color="#C42B1C" />
    <SolidColorBrush x:Key="CloseButtonPressedBrush"         Color="#A32317" />
    <SolidColorBrush x:Key="ControlBackgroundBrush"          Color="#1F1F1F" />
    <SolidColorBrush x:Key="ControlBorderBrush"              Color="#4A4A4A" />
    <SolidColorBrush x:Key="ControlHoverBorderBrush"         Color="#6E6E6E" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush"           Color="#3A3A3A" />
    <SolidColorBrush x:Key="ButtonHoverBackgroundBrush"      Color="#454545" />
    <SolidColorBrush x:Key="ButtonPressedBackgroundBrush"    Color="#323232" />
    <SolidColorBrush x:Key="AccentBrush"                     Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush"                Color="#1A86D9" />
    <SolidColorBrush x:Key="AccentPressedBrush"              Color="#006CBE" />
    <SolidColorBrush x:Key="AccentForegroundBrush"           Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBackgroundBrush"        Color="#264F78" />
    <SolidColorBrush x:Key="WarningForegroundBrush"          Color="#E5B95C" />

</ResourceDictionary>
