<UserControl x:Class="LE.SaveEditor.Presentation.Views.Toasts.ToastHost"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toasts="using:LE.SaveEditor.Presentation.Services.Toasts"
             xmlns:converters="using:LE.SaveEditor.Presentation.Converters"
             xmlns:mi="using:LE.SaveEditor.Presentation.Controls"
             x:DataType="toasts:ToastService"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="16">

    <!--
        Bottom-right stack of toasts. Placed in every window that may be in front (main window, Settings);
        only the frontmost host shows them, see ToastHost.axaml.cs.
    -->
    <UserControl.Styles>
        <!-- Slide + fade in when a toast appears. -->
        <Style Selector="Grid.toast">
            <Style.Animations>
                <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="12" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Grid.toast.success mi|MaterialIcon#SeverityIcon">
            <Setter Property="Kind" Value="CheckCircleOutline" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
        </Style>
        <Style Selector="Grid.toast.warning mi|MaterialIcon#SeverityIcon">
            <Setter Property="Kind" Value="AlertOutline" />
            <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
        </Style>
        <Style Selector="Grid.toast.error mi|MaterialIcon#SeverityIcon">
            <Setter Property="Kind" Value="AlertCircleOutline" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
        </Style>
    </UserControl.Styles>

    <ItemsControl x:Name="ToastList" ItemsSource="{Binding Toasts}" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="toasts:Toast">
                <Grid Classes="toast"
                      Width="340"
                      Margin="0,8,0,0"
                      Classes.success="{Binding Severity, Converter={x:Static converters:ValueConverters.EqualsParameter}, ConverterParameter=Success}"
                      Classes.warning="{Binding Severity, Converter={x:Static converters:ValueConverters.EqualsParameter}, ConverterParameter=Warning}"
                      Classes.error="{Binding Severity, Converter={x:Static converters:ValueConverters.EqualsParameter}, ConverterParameter=Error}">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <!-- Shadow is drawn by a separate element so the content text stays crisp. -->
                    <Border CornerRadius="8"
                            Background="{DynamicResource WindowBackgroundBrush}"
                            BoxShadow="0 2 16 0 #59000000" />

                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource TitleBarBackgroundBrush}"
                            Padding="14,12,8,12">
                        <Grid ColumnDefinitions="Auto,*,Auto">

                            <mi:MaterialIcon Name="SeverityIcon"
                                              Grid.Column="0"
                                              Width="20"
                                              Height="20"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Top"
                                              Kind="InformationOutline"
                                              Foreground="{DynamicResource AccentBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Message}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource WindowForegroundBrush}" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding Details}"
                                           Theme="{StaticResource SecondaryTextStyle}"
                                           IsVisible="{Binding HasDetails}" />
                                <ProgressBar Margin="0,8,0,0"
                                             Height="4"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             IsVisible="{Binding HasProgress}" />
                                <Button Margin="-8,6,0,0"
                                        HorizontalAlignment="Left"
                                        Theme="{StaticResource TextLinkButtonStyle}"
                                        Content="{Binding ActionText}"
                                        Command="{Binding ActionCommand}"
                                        IsVisible="{Binding HasAction}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    ToolTip.Tip="Close"
                                    Theme="{StaticResource SubtleIconButtonStyle}"
                                    Command="{Binding $parent[ItemsControl].((toasts:ToastService)DataContext).DismissCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding IsClosable}">
                                <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
