<UserControl x:Class="LE.SaveEditor.Presentation.Views.Toasts.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:toasts="clr-namespace:LE.SaveEditor.Presentation.Services.Toasts"
             xmlns:notifications="clr-namespace:LE.SaveEditor.Services.Notifications"
             xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=toasts:ToastService, IsDesignTimeCreatable=False}"
             HorizontalAlignment="Right"
             VerticalAlignment="Bottom"
             Margin="16">

    <!--
        Bottom-right stack of toasts. Placed in every window that may be in front (main window, Settings);
        only the frontmost host shows them, see ToastHost.xaml.cs.
    -->
    <ItemsControl x:Name="ToastList" ItemsSource="{Binding Toasts}" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type toasts:Toast}">
                <Grid Width="340" Margin="0,8,0,0" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="12" />
                    </Grid.RenderTransform>

                    <!-- Slide + fade in when the toast appears. -->
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)"
                                                     To="0" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>

                    <!-- Shadow is drawn by a separate element so the content text stays crisp. -->
                    <Border CornerRadius="8" Background="{DynamicResource WindowBackgroundBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.35" Color="Black" />
                        </Border.Effect>
                    </Border>

                    <Border CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource TitleBarBackgroundBrush}"
                            Padding="14,12,8,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /> <!-- severity icon -->
                                <ColumnDefinition Width="*" />    <!-- text -->
                                <ColumnDefinition Width="Auto" /> <!-- close -->
                            </Grid.ColumnDefinitions>

                            <wpf:MaterialIcon x:Name="SeverityIcon"
                                              Grid.Column="0"
                                              Width="20"
                                              Height="20"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Top"
                                              Kind="InformationOutline"
                                              Foreground="{DynamicResource AccentBrush}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Message}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource WindowForegroundBrush}" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="{Binding Details}"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ProgressBar Margin="0,8,0,0"
                                             Height="4"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding ProgressPercent, Mode=OneWay}"
                                             Visibility="{Binding HasProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Button Margin="-8,6,0,0"
                                        HorizontalAlignment="Left"
                                        Style="{StaticResource TextLinkButtonStyle}"
                                        Content="{Binding ActionText}"
                                        Command="{Binding ActionCommand}"
                                        Visibility="{Binding HasAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Top"
                                    ToolTip="Close"
                                    Style="{StaticResource SubtleIconButtonStyle}"
                                    Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Visibility="{Binding IsClosable, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <wpf:MaterialIcon Kind="Close" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Success}">
                        <Setter TargetName="SeverityIcon" Property="Kind" Value="CheckCircleOutline" />
                        <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Warning}">
                        <Setter TargetName="SeverityIcon" Property="Kind" Value="AlertOutline" />
                        <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static notifications:NotificationSeverity.Error}">
                        <Setter TargetName="SeverityIcon" Property="Kind" Value="AlertCircleOutline" />
                        <Setter TargetName="SeverityIcon" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
