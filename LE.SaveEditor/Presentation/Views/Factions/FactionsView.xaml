<UserControl x:Class="LE.SaveEditor.Presentation.Views.Factions.FactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:factionsVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Factions"
             xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=factionsVm:FactionsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="400" d:DesignWidth="700">

    <StackPanel>
        <Border Padding="16,12"
                VerticalAlignment="Top"
                Style="{StaticResource InventorySectionBorderStyle}">
            <ItemsControl Focusable="False" ItemsSource="{Binding Factions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type factionsVm:FactionViewModel}">
                        <!-- One faction: greyed out and without a usable slider until it is unlocked in game. -->
                        <Border x:Name="Row"
                                Margin="0,6"
                                Padding="12,10"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource TitleBarBackgroundBrush}"
                                ToolTip="{Binding ToolTip}"
                                ToolTipService.ShowOnDisabled="True"
                                IsEnabled="{Binding IsUnlocked}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <wpf:MaterialIcon x:Name="StateIcon"
                                                  Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                  Width="22"
                                                  Height="22"
                                                  Margin="0,0,12,0"
                                                  VerticalAlignment="Center"
                                                  Kind="ShieldStarOutline"
                                                  Foreground="{DynamicResource AccentBrush}" />

                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <!-- Not saved yet. -->
                                    <Ellipse Width="7"
                                             Height="7"
                                             Margin="8,0,0,0"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource AccentBrush}"
                                             ToolTip="Changed, not saved yet"
                                             Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding StatusText}"
                                           Style="{StaticResource SecondaryTextStyle}" />

                                <!-- Rank slider: whole ranks 0 … MaxRank; only shown once the faction is unlocked. -->
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      Margin="0,8,0,0"
                                      Visibility="{Binding IsUnlocked, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Text="0"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                    <Slider Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Minimum="0"
                                            Maximum="{Binding MaxRank, Mode=OneTime}"
                                            TickFrequency="1"
                                            SmallChange="1"
                                            LargeChange="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding Rank}" />
                                    <TextBlock Grid.Column="2"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Text="{Binding MaxRank, Mode=OneTime}"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                <Setter TargetName="StateIcon" Property="Kind" Value="LockOutline" />
                                <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock Margin="2,8,0,0" Text="{Binding Summary}" Style="{StaticResource SecondaryTextStyle}" />
        <TextBlock Margin="2,2,0,0"
                   Text="Faction ranks are kept in the stash file and shared by every character using it. Changing a rank resets the reputation towards the next one."
                   Style="{StaticResource SecondaryTextStyle}" />
    </StackPanel>
</UserControl>
