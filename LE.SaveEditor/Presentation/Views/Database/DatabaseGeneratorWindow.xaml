<Window x:Class="LE.SaveEditor.Presentation.Views.Database.DatabaseGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:generatorVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Database"
        xmlns:gameData="clr-namespace:LE.SaveEditor.Services.GameData"
        xmlns:notifications="clr-namespace:LE.SaveEditor.Services.Notifications"
        xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=generatorVm:DatabaseGeneratorViewModel, IsDesignTimeCreatable=False}"
        Title="Database"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <!-- No close button and no Escape binding: the dialog stays open until the generator has exited. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>

            <!-- ===== Content ===== -->
            <StackPanel Grid.Row="1" Margin="20,16,20,20">

                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderTextStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static notifications:NotificationSeverity.Success}">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static notifications:NotificationSeverity.Warning}">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static notifications:NotificationSeverity.Error}">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- One bar per progress bar of LE.SaveEditor.DB, added as the generator starts them. -->
                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Steps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type generatorVm:DatabaseGeneratorStepViewModel}">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <wpf:MaterialIcon x:Name="StateIcon"
                                                  Grid.Row="0"
                                                  Grid.Column="0"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"
                                                  Kind="CheckCircle"
                                                  Foreground="{DynamicResource SuccessForegroundBrush}"
                                                  Visibility="Collapsed" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           VerticalAlignment="Center"
                                           Text="{Binding Title}" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="2"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="{Binding PercentText}" />

                                <ProgressBar x:Name="Bar"
                                             Grid.Row="1"
                                             Grid.Column="0"
                                             Grid.ColumnSpan="3"
                                             Margin="0,6,0,0"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Percent, Mode=OneWay}" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="3"
                                           Margin="0,4,0,0"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding Detail}"
                                           ToolTip="{Binding Detail}"
                                           Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static generatorVm:DatabaseGeneratorStepState.Completed}">
                                    <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static generatorVm:DatabaseGeneratorStepState.Stopped}">
                                    <Setter TargetName="StateIcon" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="StateIcon" Property="Kind" Value="AlertCircle" />
                                    <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- What the generator printed: the same lines end up in the notification. -->
                <Border Margin="0,16,0,0"
                        Padding="10,8"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        Visibility="{Binding HasMessages, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Messages}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type gameData:DatabaseGeneratorMessage}">
                                    <TextBlock Margin="0,1" Text="{Binding Text}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static gameData:DatabaseGeneratorMessageLevel.Success}">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static gameData:DatabaseGeneratorMessageLevel.Warning}">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningForegroundBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static gameData:DatabaseGeneratorMessageLevel.Error}">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2"
                    Padding="20,12"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Content="OK"
                            IsDefault="True"
                            Command="{Binding OkCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
