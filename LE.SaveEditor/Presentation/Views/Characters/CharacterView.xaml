<UserControl x:Class="LE.SaveEditor.Presentation.Views.Characters.CharacterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:charactersVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Characters"
             xmlns:blessingsViews="clr-namespace:LE.SaveEditor.Presentation.Views.Blessings"
             xmlns:inventoryViews="clr-namespace:LE.SaveEditor.Presentation.Views.Inventory"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=charactersVm:CharacterViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="700" d:DesignWidth="900">

    <!--
        Details of the selected character. The TabControl itself stays the same while the selection changes
        (only its DataContext is replaced), so the open tab is kept when switching between characters.
    -->
    <TabControl x:Name="Tabs" Style="{StaticResource UnderlineTabControlStyle}">
        <TabItem x:Name="InventoryTab" Header="Inventory">
            <inventoryViews:InventoryView DataContext="{Binding Inventory}" />
        </TabItem>
        
        <TabItem x:Name="BlessingsTab" Header="Blessings">
            <blessingsViews:BlessingsView DataContext="{Binding Blessings}" />
        </TabItem>
    </TabControl>
</UserControl>
