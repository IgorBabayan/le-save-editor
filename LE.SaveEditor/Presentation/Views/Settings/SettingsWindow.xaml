<Window x:Class="LE.SaveEditor.Presentation.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:settingsVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Settings"
        xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:behaviors="clr-namespace:LE.SaveEditor.Presentation.Behaviors"
        xmlns:toastViews="clr-namespace:LE.SaveEditor.Presentation.Views.Toasts"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=settingsVm:SettingsViewModel, IsDesignTimeCreatable=False}"
        Title="Settings"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="Close"
                        Content="&#xE8BB;"
                        Command="{Binding CancelCommand}" />
            </Grid>

            <!-- ===== Content ===== -->
            <StackPanel Grid.Row="1" Margin="20,16,20,20">

                <!-- Appearance -->
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Appearance" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,2,0,8"
                           Text="Choose how the editor looks. Changes are previewed immediately." />

                <ListBox Margin="-4,0"
                         ItemsSource="{Binding ThemeOptions}"
                         SelectedItem="{Binding SelectedThemeOption}"
                         ItemContainerStyle="{StaticResource CardListBoxItemStyle}"
                         AutomationProperties.Name="Appearance"
                         KeyboardNavigation.DirectionalNavigation="Cycle">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter />
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type settingsVm:ThemeOption}">
                            <StackPanel>
                                <!-- Miniature window preview drawn with the theme's own colors -->
                                <Border Height="64"
                                        CornerRadius="4"
                                        BorderThickness="1"
                                        BorderBrush="{Binding Border}"
                                        Background="{Binding WindowBackground}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="12" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="3,3,0,0" Background="{Binding TitleBarBackground}" />
                                        <StackPanel Grid.Row="1" Margin="8,7,8,0">
                                            <Border Width="64" Height="5" HorizontalAlignment="Left"
                                                    CornerRadius="2" Background="{Binding Foreground}" />
                                            <Border Width="42" Height="5" Margin="0,5,0,0" HorizontalAlignment="Left"
                                                    CornerRadius="2" Opacity="0.5" Background="{Binding Foreground}" />
                                            <Border Width="30" Height="10" Margin="0,7,0,0" HorizontalAlignment="Left"
                                                    CornerRadius="2" Background="{Binding Accent}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Margin="2,6,2,0" Text="{Binding DisplayName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Saves folder -->
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Margin="0,20,0,0" Text="Last Epoch saves folder" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,2,0,8"
                           Text="Folder that contains your offline character saves." />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding SaveFolderPath, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Last Epoch saves folder" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Select folder"
                            AutomationProperties.Name="Select folder"
                            Command="{Binding SelectFolderCommand}">
                        <wpf:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                    </Button>
                </Grid>

                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource WarningForegroundBrush}"
                           Text="This folder does not exist."
                           Visibility="{Binding IsSaveFolderMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Updates -->
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Margin="0,20,0,0" Text="Updates" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,2,0,8"
                           Text="{Binding CurrentVersionText}" />

                <DockPanel LastChildFill="False">
                    <CheckBox DockPanel.Dock="Left"
                              VerticalAlignment="Center"
                              Content="_Auto-update"
                              IsChecked="{Binding AutoUpdate}"
                              AutomationProperties.Name="Auto-update" />
                    <Button DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Style="{StaticResource AccentButtonStyle}"
                            Content="_Download and update"
                            ToolTip="Download the new version, then restart the editor to install it"
                            Command="{Binding DownloadAndUpdateCommand}" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource DialogButtonStyle}"
                            Content="Check for _updates"
                            Command="{Binding CheckForUpdatesCommand}" />
                </DockPanel>
                <TextBlock Style="{StaticResource SecondaryTextStyle}"
                           Margin="26,4,0,0"
                           Text="On every start, check GitHub for a newer release. If one is found, it is downloaded and installed, and the editor restarts automatically." />
                <TextBlock Margin="26,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding AvailableUpdateText}"
                           Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Countdown before the editor closes to install an update -->
                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Text="Seconds before auto-restart"
                               Foreground="{DynamicResource WindowForegroundBrush}" />
                    <Button Margin="12,0,0,0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="Decrease"
                            AutomationProperties.Name="Decrease seconds before auto-restart"
                            Command="{Binding DecreaseRestartDelayCommand}">
                        <wpf:MaterialIcon Kind="Minus" Width="16" Height="16" />
                    </Button>
                    <TextBox Width="64"
                             Margin="4,0"
                             HorizontalContentAlignment="Center"
                             MaxLength="3"
                             Text="{Binding RestartDelayText, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:NumericInput.IsEnabled="True"
                             behaviors:NumericInput.Maximum="{Binding MaxRestartDelaySeconds}"
                             AutomationProperties.Name="Seconds before auto-restart" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            ToolTip="Increase"
                            AutomationProperties.Name="Increase seconds before auto-restart"
                            Command="{Binding IncreaseRestartDelayCommand}">
                        <wpf:MaterialIcon Kind="Plus" Width="16" Height="16" />
                    </Button>
                </StackPanel>
                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource WarningForegroundBrush}"
                           Visibility="{Binding IsRestartDelayInvalid, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="Enter a number from 0 to" />
                    <Run Text="{Binding MaxRestartDelaySeconds, Mode=OneWay}" /><Run Text="." />
                </TextBlock>

                <TextBlock Margin="0,6,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningForegroundBrush}"
                           Text="This copy was not installed with the installer, so it will not be updated."
                           Visibility="{Binding IsNotInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- ===== Toasts (bottom-right, above the content) ===== -->
            <toastViews:ToastHost Grid.Row="1" Panel.ZIndex="10" />

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2"
                    Padding="20,12"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Content="Save"
                            IsDefault="True"
                            Command="{Binding SaveCommand}" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource DialogButtonStyle}"
                            Content="Cancel"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
