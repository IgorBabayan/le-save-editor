<UserControl x:Class="LE.SaveEditor.Presentation.Views.Blessings.BlessingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:blessingsVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Blessings"
             xmlns:inventoryVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Inventory"
             xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=blessingsVm:BlessingsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Placeholder shown in an icon box while the blessing has no icon (or the slot is empty). -->
        <Style x:Key="BlessingPlaceholderIconStyle" TargetType="wpf:MaterialIcon">
            <Setter Property="Kind" Value="StarOutline" />
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Square icon box: the blessing icon, or the placeholder without one. -->
        <Style x:Key="BlessingIconBoxStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource TitleBarBackgroundBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- Header of a blessing group: chevron, group name and how many blessings it holds; click to collapse. -->
        <Style x:Key="BlessingGroupToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Margin="4,8,4,2"
                                Padding="6,4"
                                CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <wpf:MaterialIcon x:Name="Chevron"
                                                  Width="16"
                                                  Height="16"
                                                  Margin="0,0,6,0"
                                                  VerticalAlignment="Center"
                                                  Kind="ChevronDown"
                                                  Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Chevron" Property="Kind" Value="ChevronRight" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A row of the echo list or the blessing list: hover highlight, and the accent bar and selection background while
            its item is selected (IsSelected of the echo / blessing).
        -->
        <Style x:Key="BlessingRowButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="4"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Indicator"
                                        Width="3"
                                        Margin="0,8"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1.5"
                                        Background="{DynamicResource AccentBrush}"
                                        Visibility="Collapsed" />
                                <ContentPresenter Margin="12,8,10,8"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}" />
                            </Trigger>
                            <!-- Declared last so it wins over hover. -->
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A group of the blessing list; its rows hide while the header is collapsed (see the code-behind). -->
        <Style x:Key="BlessingGroupItemStyle" TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <ToggleButton x:Name="Toggle"
                                          IsChecked="True"
                                          Style="{StaticResource BlessingGroupToggleStyle}"
                                          Tag="{Binding Name}"
                                          Loaded="GroupToggle_OnLoaded"
                                          Click="GroupToggle_OnClick">
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='({0})'}" FontWeight="Normal" />
                                </TextBlock>
                            </ToggleButton>
                            <ItemsPresenter x:Name="Rows" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="Toggle" Property="IsChecked" Value="False">
                                <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One rolled stat of the selected blessing: its tooltip line and a slider over the 0…255 roll. -->
        <DataTemplate x:Key="BlessingStatTemplate" DataType="{x:Type inventoryVm:ItemStatViewModel}">
            <StackPanel Margin="0,6,0,0">
                <TextBlock TextWrapping="Wrap" Text="{Binding DisplayText}" />
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="320" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Fixed 0…255 range (the roll the game stores): no binding order can clamp the value. -->
                    <Slider Grid.Column="0"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="{x:Static inventoryVm:ItemStatViewModel.MaxRoll}"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="16"
                            IsSnapToTickEnabled="True"
                            IsEnabled="{Binding IsEditable, Mode=OneTime}"
                            Value="{Binding Roll}" />
                    <TextBlock Grid.Column="1"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Style="{StaticResource SecondaryTextStyle}"
                               Text="{Binding RangeText}" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- ===== No timelines in the game database ===== -->
        <Border Style="{StaticResource InventorySectionBorderStyle}"
                Visibility="{Binding IsDatabaseMissing, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock MaxWidth="520"
                       TextWrapping="Wrap"
                       Text="The game database holds no timelines yet, so blessings cannot be listed. Generate or update it with the database button in the title bar. The blessings in the save stay as they are."
                       Style="{StaticResource EmptyPageTextStyle}" />
        </Border>

        <Grid Visibility="{Binding HasEchoes, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Echoes (timelines) with the blessing each holds ===== -->
            <Border Grid.Row="0" Grid.Column="0"
                    Padding="0,4"
                    VerticalAlignment="Top"
                    Style="{StaticResource InventorySectionBorderStyle}">
                <!--
                    Plain rows that select the echo with a command, not a ListBox: a ListBox also selects the rows the mouse
                    passes over while the button is down, and the page shifts under the mouse when the echo's panel changes
                    height, so a click selected another echo.
                -->
                <ItemsControl x:Name="EchoList"
                              Focusable="False"
                              ItemsSource="{Binding Echoes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type blessingsVm:BlessingEchoViewModel}">
                            <Button Style="{StaticResource BlessingRowButtonStyle}"
                                    Command="{Binding DataContext.SelectEchoCommand, ElementName=EchoList}"
                                    CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" Style="{StaticResource BlessingIconBoxStyle}">
                                    <Grid>
                                        <Image Margin="3"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding Icon}" />
                                        <wpf:MaterialIcon Width="18" Height="18" Style="{StaticResource BlessingPlaceholderIconStyle}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                    <TextBlock TextTrimming="CharacterEllipsis"
                                               Text="{Binding SelectedName}"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <!-- Not saved yet. -->
                                <Ellipse Grid.Column="2"
                                         Width="7"
                                         Height="7"
                                         Margin="6,0,0,0"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource AccentBrush}"
                                         ToolTip="Changed, not saved yet"
                                         Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ===== Blessing of the selected echo and the blessings its timeline grants ===== -->
            <Border Grid.Row="0" Grid.Column="2"
                    Padding="16,12"
                    VerticalAlignment="Top"
                    Style="{StaticResource InventorySectionBorderStyle}">
                <StackPanel DataContext="{Binding SelectedEcho}">
                    <!-- Header: timeline name and level, revert / remove actions. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeaderTextStyle}" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding LevelText}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource TextLinkButtonStyle}"
                                    ToolTip="Back to the blessing in the save file"
                                    Command="{Binding RevertCommand}"
                                    Visibility="{Binding HasChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <wpf:MaterialIcon Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Kind="Undo" />
                                    <TextBlock VerticalAlignment="Center" Text="Revert" />
                                </StackPanel>
                            </Button>
                            <Button Margin="4,0,0,0"
                                    Style="{StaticResource TextLinkButtonStyle}"
                                    ToolTip="Empty the blessing slot of this echo"
                                    Command="{Binding RemoveCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <wpf:MaterialIcon Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Kind="TrashCanOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="Remove" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- The blessing in the slot with its roll sliders. -->
                    <Border Margin="0,12,0,0"
                            Padding="12,10"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource TitleBarBackgroundBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="56"
                                    Height="56"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource BlessingIconBoxStyle}"
                                    Background="{DynamicResource ControlBackgroundBrush}">
                                <Grid>
                                    <Image Margin="4"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding Icon}" />
                                    <wpf:MaterialIcon Width="26" Height="26" Style="{StaticResource BlessingPlaceholderIconStyle}" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding SelectedName}" />
                                <TextBlock Margin="0,2,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningForegroundBrush}"
                                           Text="Not discovered in the stash yet: saving marks it as discovered."
                                           Visibility="{Binding IsUndiscovered, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Margin="0,2,0,0"
                                           Text="Pick one of the blessings below."
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Visibility="{Binding HasBlessing, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <ItemsControl Focusable="False"
                                              ItemsSource="{Binding Stats}"
                                              ItemTemplate="{StaticResource BlessingStatTemplate}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Blessings the timeline grants, normal ones first, then the Grand ones. -->
                    <TextBlock Margin="2,16,0,4" Text="Choose a blessing" Style="{StaticResource SecondaryTextStyle}" />
                    <!--
                        Plain rows that pick the blessing with a command, not a ListBox: a list bound to a collection view
                        follows the view's current item, which selected (and so picked) the first blessing of every echo
                        that was opened.
                    -->
                    <ItemsControl x:Name="OptionList"
                                  Focusable="False"
                                  ItemsSource="{Binding OptionsView}">
                        <!-- Collapsible groups: Blessings, Grand blessings, Other. -->
                        <ItemsControl.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource BlessingGroupItemStyle}" />
                        </ItemsControl.GroupStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type blessingsVm:BlessingOptionViewModel}">
                                <Button Style="{StaticResource BlessingRowButtonStyle}"
                                        Command="{Binding DataContext.PickCommand, ElementName=OptionList}"
                                        CommandParameter="{Binding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            VerticalAlignment="Top"
                                            Style="{StaticResource BlessingIconBoxStyle}">
                                        <Grid>
                                            <Image Margin="2"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding Icon}" />
                                            <wpf:MaterialIcon Width="16" Height="16" Style="{StaticResource BlessingPlaceholderIconStyle}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock TextWrapping="Wrap"
                                                   Text="{Binding StatsText}"
                                                   Style="{StaticResource SecondaryTextStyle}" />
                                    </StackPanel>
                                </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="2,8,0,0">
                <TextBlock Text="{Binding Summary}" Style="{StaticResource SecondaryTextStyle}" />
                <!-- Held blessings the stash has not discovered (the game shows them as "Undiscovered"). -->
                <TextBlock Margin="0,2,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource WarningForegroundBrush}"
                           Text="{Binding DiscoveryHint}"
                           Visibility="{Binding HasDiscoveryHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
