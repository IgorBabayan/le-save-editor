<Window x:Class="LE.SaveEditor.Presentation.Views.Inventory.CraftingMaterialPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviors="clr-namespace:LE.SaveEditor.Presentation.Behaviors"
        xmlns:inventoryVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Inventory"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=inventoryVm:CraftingMaterialPickerViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}"
        Width="480"
        Height="600"
        MinWidth="380"
        MinHeight="420"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="4"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A kind tab: a pill that is highlighted while its kind is shown. -->
        <Style x:Key="KindPillStyle" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Padding="12,5"
                                CornerRadius="13"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="Text"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource WindowForegroundBrush}"
                                       Text="{TemplateBinding Content}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Text" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding Title}" />
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="Close"
                        Content="&#xE8BB;"
                        Click="OnCancelClick" />
            </Grid>

            <!-- ===== Kind tabs, search, list and description ===== -->
            <Grid Grid.Row="1" Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" ItemsSource="{Binding Kinds}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type inventoryVm:CraftingMaterialKindOption}">
                            <RadioButton GroupName="MaterialKind"
                                         Style="{StaticResource KindPillStyle}"
                                         Content="{Binding Label}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBox x:Name="SearchBox"
                         Grid.Row="1"
                         Margin="0,12,0,8"
                         Padding="6,3"
                         ToolTip="Search by name; shards also by prefix / suffix and affix category"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="OnSearchBoxPreviewKeyDown" />

                <Border Grid.Row="2"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        Background="{DynamicResource TitleBarBackgroundBrush}">
                    <Grid>
                        <ListBox x:Name="MaterialList"
                                 Margin="0,4"
                                 ItemsSource="{Binding Options}"
                                 SelectedItem="{Binding SelectedOption}"
                                 behaviors:SelectOnClick.IsEnabled="True"
                                 IsSynchronizedWithCurrentItem="False"
                                 Style="{StaticResource PlainListBoxStyle}"
                                 ItemContainerStyle="{StaticResource ListRowItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 MouseDoubleClick="OnMaterialListMouseDoubleClick"
                                 KeyDown="OnMaterialListKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type inventoryVm:CraftingMaterialOptionViewModel}">
                                    <Grid ToolTip="{Binding ToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Width="28"
                                               Height="28"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding Icon}" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                            <TextBlock FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding Details}"
                                                       Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="16,24"
                                   VerticalAlignment="Top"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding EmptyText}"
                                   Visibility="{Binding HasOptions, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <!-- What the selected material does. -->
                <TextBlock Grid.Row="3"
                           Margin="2,10,2,0"
                           MinHeight="40"
                           MaxHeight="120"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="{Binding SelectionDescription}" />
            </Grid>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2"
                    Padding="16,12"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Content="{Binding ApplyText}"
                            IsDefault="True"
                            Command="{Binding ApplyCommand}" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource DialogButtonStyle}"
                            Content="_Cancel"
                            IsCancel="True"
                            Click="OnCancelClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
