<views:ChromeWindow x:Class="LE.SaveEditor.Presentation.Views.Inventory.CraftingMaterialPickerWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LE.SaveEditor.Presentation.Views"
        xmlns:mi="using:LE.SaveEditor.Presentation.Controls"
        xmlns:behaviors="using:LE.SaveEditor.Presentation.Behaviors"
        xmlns:inventoryVm="using:LE.SaveEditor.Presentation.ViewModels.Inventory"
        x:DataType="inventoryVm:CraftingMaterialPickerViewModel"
        Title="{Binding Title}"
        Width="480"
        Height="600"
        MinWidth="380"
        MinHeight="420"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Classes="titlebar" Background="{DynamicResource TitleBarBackgroundBrush}">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding Title}" />
                <Button HorizontalAlignment="Right"
                        Theme="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip.Tip="Close"
                        Click="OnCancelClick">
                    <mi:MaterialIcon Width="14" Height="14" Kind="WindowClose" />
                </Button>
            </Grid>

            <!-- ===== Search, list and description ===== -->
            <Grid Grid.Row="1" Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Row="0"
                         Margin="0,0,0,8"
                         Padding="6,3"
                         ToolTip.Tip="{Binding SearchToolTip}"
                         Text="{Binding SearchText}" />

                <Border Grid.Row="1"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        Background="{DynamicResource TitleBarBackgroundBrush}">
                    <Grid>
                        <ListBox x:Name="MaterialList"
                                 Margin="0,4"
                                 ItemsSource="{Binding Options}"
                                 SelectedItem="{Binding SelectedOption}"
                                 behaviors:SelectOnClick.IsEnabled="True"
                                 Theme="{StaticResource PlainListBoxStyle}"
                                 ItemContainerTheme="{StaticResource ListRowItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="inventoryVm:CraftingMaterialOptionViewModel">
                                    <Grid ToolTip.Tip="{Binding ToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Width="28"
                                               Height="28"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                               Source="{Binding Icon}" />
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                            <TextBlock FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Theme="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding Details}"
                                                       IsVisible="{Binding HasDetails}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="16,24"
                                   VerticalAlignment="Top"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Theme="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding EmptyText}"
                                   IsVisible="{Binding !HasOptions}" />
                    </Grid>
                </Border>

                <!-- What the selected material does. -->
                <TextBlock Grid.Row="2"
                           Margin="2,10,2,0"
                           MinHeight="40"
                           MaxHeight="120"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Theme="{StaticResource SecondaryTextStyle}"
                           Text="{Binding SelectionDescription}" />
            </Grid>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2"
                    Padding="16,12"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Theme="{StaticResource AccentButtonStyle}"
                            Content="{Binding ApplyText}"
                            IsDefault="True"
                            Command="{Binding ApplyCommand}" />
                    <Button Margin="8,0,0,0"
                            Theme="{StaticResource DialogButtonStyle}"
                            Content="_Cancel"
                            IsCancel="True"
                            Click="OnCancelClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</views:ChromeWindow>
