<UserControl x:Class="LE.SaveEditor.Presentation.Views.Inventory.ItemInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inventoryVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Inventory"
             xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inventoryVm:ItemBuilderViewModel, IsDesignTimeCreatable=False}"
             Width="460"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             Foreground="{DynamicResource WindowForegroundBrush}">

    <!--
        Compact item builder shown next to an equipment slot, laid out like an object inspector:
        a name column and a value column, rows with a chevron expand into sub-properties
        (rarity pills, the item list, implicit / unique stats, affix slots with their tier and stats).
    -->
    <UserControl.Resources>
        <!-- Width of the name column; values start right after it. -->
        <GridLength x:Key="InspectorNameWidth">200</GridLength>
        <Thickness x:Key="InspectorValueMargin">208,0,6,0</Thickness>
        <Thickness x:Key="IndentLevel1">14,0,0,0</Thickness>
        <Thickness x:Key="IndentLevel2">28,0,0,0</Thickness>

        <!-- Read-only (or slider) row: Header in the name column, Content in the value column. Padding indents the name. -->
        <Style x:Key="InspectorRowStyle" TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Border MinHeight="26"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource InspectorNameWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        BorderThickness="0,0,1,0"
                                        BorderBrush="{DynamicResource ControlBorderBrush}">
                                    <Border Margin="{TemplateBinding Padding}" Padding="22,4,6,4">
                                        <ContentPresenter VerticalAlignment="Center" ContentSource="Header" />
                                    </Border>
                                </Border>
                                <ContentPresenter Grid.Column="1" Margin="8,3,6,3" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Expandable row: the whole row toggles, a chevron shows the state. The value is laid over the row
            (InspectorValueMargin) by the parent grid, so it can hold its own buttons.
        -->
        <Style x:Key="InspectorExpanderStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                MinHeight="26"
                                Background="Transparent"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource InspectorNameWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        BorderThickness="0,0,1,0"
                                        BorderBrush="{DynamicResource ControlBorderBrush}">
                                    <DockPanel Margin="{TemplateBinding Padding}">
                                        <wpf:MaterialIcon x:Name="Chevron"
                                                          DockPanel.Dock="Left"
                                                          Width="14"
                                                          Height="14"
                                                          Margin="4,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Kind="ChevronRight"
                                                          Foreground="{DynamicResource SecondaryForegroundBrush}" />
                                        <ContentPresenter Margin="4,4,6,4" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="Kind" Value="ChevronDown" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}" />
                            </Trigger>
                            <!-- Nothing to expand (e.g. an empty affix slot): no chevron, the label keeps its place. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel under an expanded row (rarity pills, item list, affix picker). -->
        <Style x:Key="InspectorDropDownBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        </Style>

        <!-- Small link button inside a value cell. -->
        <Style x:Key="InspectorLinkButtonStyle" TargetType="Button" BasedOn="{StaticResource TextLinkButtonStyle}">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- One implicit / unique / affix stat: its tooltip line in the name column, a slider over the 0…255 roll as value. -->
        <DataTemplate x:Key="StatRowTemplate" DataType="{x:Type inventoryVm:ItemStatViewModel}">
            <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                    Padding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <HeaderedContentControl.Header>
                    <TextBlock TextWrapping="Wrap" Text="{Binding DisplayText}" />
                </HeaderedContentControl.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Fixed 0…255 range (the roll the game stores): no binding order can clamp the value. -->
                    <Slider Grid.Column="0"
                            VerticalAlignment="Center"
                            Minimum="0"
                            Maximum="{x:Static inventoryVm:ItemStatViewModel.MaxRoll}"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="16"
                            IsSnapToTickEnabled="True"
                            IsEnabled="{Binding IsEditable, Mode=OneTime}"
                            Value="{Binding Roll}" />
                    <TextBlock Grid.Column="1"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Style="{StaticResource SecondaryTextStyle}"
                               Text="{Binding RangeText}" />
                </Grid>
            </HeaderedContentControl>
        </DataTemplate>

        <!-- Item list (bases / uniques / set items) grouped by the classes that can equip them. -->
        <CollectionViewSource x:Key="GroupedBases" Source="{Binding Bases}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- Affix picker entries grouped by category ("Melee", "Set", "Corrupted", ...). -->
        <CollectionViewSource x:Key="GroupedAffixes" Source="{Binding AffixOptions}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <GroupStyle x:Key="ListGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <TextBlock Margin="8,8,8,2"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="{Binding Name}" />
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <!-- Affix picker shown under the slot being filled (DataContext: AffixSlotViewModel). -->
        <DataTemplate x:Key="AffixPickerTemplate" DataType="{x:Type inventoryVm:AffixSlotViewModel}">
            <Border Style="{StaticResource InspectorDropDownBorderStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource InspectorLinkButtonStyle}"
                                Content="Cancel"
                                Command="{Binding DataContext.CloseAffixPickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        <TextBox x:Name="AffixSearch"
                                 Padding="6,3"
                                 ToolTip="Filter affixes by name, title or category"
                                 Text="{Binding DataContext.AffixSearchText, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 Loaded="OnAffixSearchLoaded" />
                    </DockPanel>
                    <Grid>
                        <ListBox MaxHeight="260"
                                 ItemsSource="{Binding Source={StaticResource GroupedAffixes}}"
                                 SelectedItem="{Binding DataContext.SelectedAffixOption, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                 IsSynchronizedWithCurrentItem="False"
                                 Style="{StaticResource PlainListBoxStyle}"
                                 ItemContainerStyle="{StaticResource ListRowItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                            <ListBox.GroupStyle>
                                <StaticResource ResourceKey="ListGroupStyle" />
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type inventoryVm:AffixOptionViewModel}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       FontSize="11"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding Details}" />
                                        </Grid>
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   Text="{Binding TopTierText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="8,12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="No affixes of this kind can be crafted on this item."
                                   Visibility="{Binding DataContext.HasAffixOptions, Converter={StaticResource InverseBooleanToVisibilityConverter}, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One affix slot: label + affix name (or "Add prefix"); expands into its tier and stats. -->
        <DataTemplate x:Key="AffixSlotRowTemplate" DataType="{x:Type inventoryVm:AffixSlotViewModel}">
            <StackPanel>
                <Grid>
                    <ToggleButton x:Name="Toggle"
                                  Style="{StaticResource InspectorExpanderStyle}"
                                  Padding="{StaticResource IndentLevel1}"
                                  IsChecked="True"
                                  IsEnabled="{Binding HasAffix}">
                        <TextBlock x:Name="SlotLabel" FontWeight="SemiBold" Text="{Binding Label}" />
                    </ToggleButton>

                    <!-- Value: the affix name with Change / Remove, or "Add …" for an empty slot. -->
                    <DockPanel Margin="{StaticResource InspectorValueMargin}" LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource InspectorLinkButtonStyle}"
                                Content="Remove"
                                Command="{Binding RemoveCommand}"
                                Visibility="{Binding HasAffix, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource InspectorLinkButtonStyle}"
                                Content="Change"
                                Command="{Binding ChooseCommand}"
                                Visibility="{Binding HasAffix, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button HorizontalAlignment="Left"
                                Margin="-6,0,0,0"
                                Style="{StaticResource InspectorLinkButtonStyle}"
                                Content="{Binding AddText}"
                                Command="{Binding ChooseCommand}"
                                Visibility="{Binding HasAffix, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <TextBlock VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name}"
                                   ToolTip="{Binding Name}"
                                   Visibility="{Binding HasAffix, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </DockPanel>
                </Grid>

                <!-- Sub-properties: tier, then a slider per stat of that tier. -->
                <StackPanel Visibility="{Binding IsChecked, ElementName=Toggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                            Padding="{StaticResource IndentLevel2}"
                                            Header="Tier"
                                            Visibility="{Binding HasTiers, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Minimum="1"
                                    Maximum="{Binding MaxTier}"
                                    TickFrequency="1"
                                    SmallChange="1"
                                    LargeChange="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding TierNumber}" />
                            <TextBlock Grid.Column="1"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding TierText}" />
                        </Grid>
                    </HeaderedContentControl>
                    <ItemsControl ItemsSource="{Binding Stats}"
                                  ItemTemplate="{StaticResource StatRowTemplate}"
                                  Tag="{StaticResource IndentLevel2}"
                                  Focusable="False" />
                </StackPanel>

                <!-- The picker exists only for the slot being filled (one list, one selection binding). -->
                <ContentControl Focusable="False" Content="{Binding}">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{x:Null}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPicking}" Value="True">
                                    <Setter Property="ContentTemplate" Value="{StaticResource AffixPickerTemplate}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSealed}" Value="True">
                    <Setter TargetName="SlotLabel" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCorrupted}" Value="True">
                    <Setter TargetName="SlotLabel" Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ApplyCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <!-- Shadow on its own layer: an effect on the content would turn off ClearType for every text in it. -->
        <Border CornerRadius="8" Background="{DynamicResource WindowBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black" />
            </Border.Effect>
        </Border>
        <Border CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{Binding RarityForeground}"
                Background="{DynamicResource WindowBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== Header: icon, name and type of the item, tinted with the rarity ===== -->
                <Border Grid.Row="0"
                        Padding="12,10,6,10"
                        CornerRadius="7,7,0,0"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{Binding RarityForeground}"
                        Background="{Binding RarityBackground}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="48"
                                Height="48"
                                Margin="0,0,10,0"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{Binding RarityForeground}">
                            <Grid>
                                <Image Margin="4"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding Icon}" />
                                <wpf:MaterialIcon Width="22"
                                                  Height="22"
                                                  Kind="ShieldOutline"
                                                  Opacity="0.6"
                                                  Foreground="{Binding RarityForeground}">
                                    <!-- Placeholder while the item has no icon. -->
                                    <wpf:MaterialIcon.Style>
                                        <Style TargetType="wpf:MaterialIcon">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </wpf:MaterialIcon.Style>
                                </wpf:MaterialIcon>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{Binding RarityForeground}"
                                       Text="{Binding ItemName}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding Subtitle}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top" Orientation="Horizontal">
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    ToolTip="Open the full item builder"
                                    Click="OnExpandClick">
                                <wpf:MaterialIcon Width="16" Height="16" Kind="ArrowExpand" />
                            </Button>
                            <Button Style="{StaticResource SubtleIconButtonStyle}"
                                    ToolTip="Close (Esc)"
                                    Command="{Binding CancelCommand}">
                                <wpf:MaterialIcon Width="16" Height="16" Kind="Close" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Properties ===== -->
                <ScrollViewer x:Name="PropertiesScroll"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- base.db missing: nothing can be listed. -->
                        <TextBlock Margin="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource WarningForegroundBrush}"
                                   Text="{Binding EmptyBasesText}"
                                   Visibility="{Binding IsDatabaseAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                        <!-- Rarity: the value is the current rarity; expanding shows the rarity pills. -->
                        <Grid>
                            <ToggleButton x:Name="RarityToggle" Style="{StaticResource InspectorExpanderStyle}" Content="Rarity" />
                            <StackPanel Margin="{StaticResource InspectorValueMargin}"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        IsHitTestVisible="False">
                                <Ellipse Width="8"
                                         Height="8"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{Binding SelectedRarity.Foreground}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding SelectedRarity.Foreground}"
                                           Text="{Binding SelectedRarity.Name}" />
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource InspectorDropDownBorderStyle}"
                                Padding="22,8,8,2"
                                Visibility="{Binding IsChecked, ElementName=RarityToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Pills ask the view model; only it marks a rarity as selected (a declined change moves nothing). -->
                            <ItemsControl ItemsSource="{Binding Rarities}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type inventoryVm:RarityOptionViewModel}">
                                        <Button Style="{StaticResource RarityPillButtonStyle}"
                                                Command="{Binding DataContext.SelectRarityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Click="OnRarityPillClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Item: the value is the selected base / unique / set item; expanding shows the searchable list
                             with the search box focused. -->
                        <Grid>
                            <ToggleButton x:Name="ItemToggle"
                                          Style="{StaticResource InspectorExpanderStyle}"
                                          Content="{Binding ListHeader}"
                                          IsEnabled="{Binding IsDatabaseAvailable}"
                                          Checked="OnItemToggleChecked" />
                            <TextBlock Margin="{StaticResource InspectorValueMargin}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{Binding RarityForeground}"
                                       Text="{Binding ItemName}" />
                        </Grid>
                        <Border Style="{StaticResource InspectorDropDownBorderStyle}"
                                Visibility="{Binding IsChecked, ElementName=ItemToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBox x:Name="ItemSearch"
                                         Margin="0,0,0,6"
                                         Padding="6,3"
                                         ToolTip="Search bases, unique and set items by name, type or class"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Margin="0,0,0,6"
                                          FontSize="12"
                                          Foreground="{DynamicResource SecondaryForegroundBrush}"
                                          Content="{Binding OnlyUsableText}"
                                          ToolTip="Hide items this character's class cannot equip"
                                          IsChecked="{Binding ShowOnlyUsable}" />
                                <Grid>
                                    <ListBox x:Name="ItemList"
                                             MaxHeight="300"
                                             ItemsSource="{Binding Source={StaticResource GroupedBases}}"
                                             SelectedItem="{Binding SelectedBaseOption}"
                                             IsSynchronizedWithCurrentItem="False"
                                             Style="{StaticResource PlainListBoxStyle}"
                                             ItemContainerStyle="{StaticResource ListRowItemStyle}"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                             PreviewMouseLeftButtonUp="OnItemListPreviewMouseLeftButtonUp"
                                             KeyDown="OnItemListKeyDown">
                                        <ListBox.GroupStyle>
                                            <StaticResource ResourceKey="ListGroupStyle" />
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type inventoryVm:BaseOptionViewModel}">
                                                <Grid x:Name="Row" ToolTip="{Binding ToolTip}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="32" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0"
                                                           Width="28"
                                                           Height="28"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Source="{Binding Icon}" />
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding TitleForeground}"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   Text="{Binding TypeLine}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <!-- Found by a search in another list than the selected rarity's. -->
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding TitleForeground}"
                                                                   Text="{Binding KindLabel}"
                                                                   Visibility="{Binding IsFromOtherList, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <TextBlock HorizontalAlignment="Right"
                                                                   FontSize="11"
                                                                   Style="{StaticResource SecondaryTextStyle}"
                                                                   Text="{Binding Base.LevelRequirement, StringFormat='Lv {0}'}"
                                                                   Visibility="{Binding HasLevelRequirement, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <!-- Other classes' items stay selectable but are dimmed. -->
                                                    <DataTrigger Binding="{Binding IsUsable}" Value="False">
                                                        <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Margin="8,12"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="{Binding EmptyBasesText}"
                                               Visibility="{Binding HasBases, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Read-only facts of the selection. -->
                        <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                Header="Level requirement"
                                                Visibility="{Binding HasLevelText, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{Binding SelectedBase.LevelRequirement}" />
                        </HeaderedContentControl>
                        <Border Padding="12,6"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Visibility="{Binding IsSelectedBaseForOtherClass, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource WarningForegroundBrush}"
                                       Text="{Binding ClassWarningText}" />
                        </Border>

                        <StackPanel Visibility="{Binding HasSelectedBase, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- ===== Implicit stats ===== -->
                            <Grid>
                                <ToggleButton x:Name="ImplicitsToggle"
                                              Style="{StaticResource InspectorExpanderStyle}"
                                              Content="Implicit stats"
                                              IsChecked="True" />
                                <TextBlock Margin="{StaticResource InspectorValueMargin}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Text="{Binding Stats.Count, StringFormat='({0})'}" />
                            </Grid>
                            <StackPanel Visibility="{Binding IsChecked, ElementName=ImplicitsToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <!-- base.db from before stat names were stored: names read "Property 10". -->
                                <TextBlock Margin="36,6,12,6"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningForegroundBrush}"
                                           Text="Stat names are missing because the game database is out of date. Update it with the database button in the title bar."
                                           Visibility="{Binding IsDatabaseOutdated, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <HeaderedContentControl Style="{StaticResource InspectorRowStyle}"
                                                        Padding="{StaticResource IndentLevel1}"
                                                        Header="None"
                                                        Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                        Visibility="{Binding HasStats, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                <ItemsControl ItemsSource="{Binding Stats}"
                                              ItemTemplate="{StaticResource StatRowTemplate}"
                                              Tag="{StaticResource IndentLevel1}"
                                              Focusable="False" />
                            </StackPanel>

                            <!-- ===== Unique / set modifiers and effects ===== -->
                            <StackPanel Visibility="{Binding HasUniqueSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <ToggleButton x:Name="UniqueToggle" Style="{StaticResource InspectorExpanderStyle}" IsChecked="True">
                                        <TextBlock Foreground="{Binding RarityForeground}" Text="{Binding ModStatsHeader}" />
                                    </ToggleButton>
                                    <TextBlock Margin="{StaticResource InspectorValueMargin}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="{Binding ModStats.Count, StringFormat='({0})'}" />
                                </Grid>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=UniqueToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding ModStats}"
                                                  ItemTemplate="{StaticResource StatRowTemplate}"
                                                  Tag="{StaticResource IndentLevel1}"
                                                  Focusable="False" />
                                    <!-- Effects that do not roll, e.g. "You are immune to Blind and Chill". -->
                                    <ItemsControl ItemsSource="{Binding Effects}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="36,4,8,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource ControlBorderBrush}">
                                                    <TextBlock FontStyle="Italic"
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding DataContext.RarityForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>

                            <!-- ===== Affix slots ===== -->
                            <StackPanel Visibility="{Binding HasAffixSlots, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid>
                                    <ToggleButton x:Name="AffixesToggle"
                                                  Style="{StaticResource InspectorExpanderStyle}"
                                                  Content="{Binding AffixesHeader}"
                                                  IsChecked="True" />
                                    <TextBlock Margin="{StaticResource InspectorValueMargin}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="{Binding AffixSummary}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding AffixSlots}"
                                              ItemTemplate="{StaticResource AffixSlotRowTemplate}"
                                              Focusable="False"
                                              Visibility="{Binding IsChecked, ElementName=AffixesToggle, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Footer ===== -->
                <Border Grid.Row="2"
                        Padding="10,8"
                        CornerRadius="0,0,7,7"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        Background="{DynamicResource TitleBarBackgroundBrush}">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="Ctrl+Enter apply · Esc cancel" />
                        <Button DockPanel.Dock="Right"
                                Margin="8,0,0,0"
                                Style="{StaticResource DialogButtonStyle}"
                                Content="Cancel"
                                Command="{Binding CancelCommand}" />
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource AccentButtonStyle}"
                                Content="Apply"
                                Command="{Binding ApplyCommand}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
