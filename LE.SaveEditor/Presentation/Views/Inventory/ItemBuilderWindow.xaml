<Window x:Class="LE.SaveEditor.Presentation.Views.Inventory.ItemBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:inventoryVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Inventory"
        xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=inventoryVm:ItemBuilderViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="520"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="4"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One implicit / unique modifier: its tooltip line, its range and a slider over the 0…255 roll. -->
        <DataTemplate x:Key="StatTemplate" DataType="{x:Type inventoryVm:ItemStatViewModel}">
            <StackPanel Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding DisplayText}" />
                    <TextBlock Grid.Column="1"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource SecondaryTextStyle}"
                               Text="{Binding RangeText}" />
                </Grid>
                <!-- Fixed 0…255 range (the roll the game stores): no binding order can clamp the value. -->
                <Slider Margin="0,6,0,0"
                        Minimum="0"
                        Maximum="{x:Static inventoryVm:ItemStatViewModel.MaxRoll}"
                        TickFrequency="1"
                        SmallChange="1"
                        LargeChange="16"
                        IsSnapToTickEnabled="True"
                        IsEnabled="{Binding IsEditable, Mode=OneTime}"
                        Value="{Binding Roll}" />
            </StackPanel>
        </DataTemplate>

        <!-- One card of the item grid: fixed width, highlighted when hovered and outlined in the accent color when selected. -->
        <Style x:Key="ItemCardStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="300" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource WindowForegroundBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Padding="12,10"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource TitleBarBackgroundBrush}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                            </Trigger>
                            <!-- Declared last so it wins over hover. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Padding" Value="11,9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bases grouped by the classes that can equip them; the view model already orders them group by group. -->
        <CollectionViewSource x:Key="GroupedBases" Source="{Binding Bases}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding Title}" />
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="Close"
                        Content="&#xE8BB;"
                        Command="{Binding CancelCommand}" />
            </Grid>

            <!-- ===== Rarity ===== -->
            <StackPanel Grid.Row="1" Margin="20,16,20,4">
                <TextBlock Margin="0,0,0,8" Text="Rarity" Style="{StaticResource SectionHeaderTextStyle}" />
                <!-- Pills ask the view model; only it marks a rarity as selected (a declined change moves nothing). -->
                <ItemsControl ItemsSource="{Binding Rarities}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type inventoryVm:RarityOptionViewModel}">
                            <Button Style="{StaticResource RarityPillButtonStyle}"
                                    Command="{Binding DataContext.SelectRarityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== Preview + stats (left) | bases (right) ===== -->
            <Grid Grid.Row="2" Margin="20,8,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Preview card: background follows the rarity. -->
                <Border Grid.Column="0"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{Binding RarityForeground}"
                        Background="{DynamicResource ControlBackgroundBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header tinted with the rarity color. -->
                        <Border Grid.Row="0"
                                Padding="16,14"
                                CornerRadius="8,8,0,0"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{Binding RarityForeground}"
                                Background="{Binding RarityBackground}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="72"
                                        Height="72"
                                        Margin="0,0,14,0"
                                        CornerRadius="6"
                                        BorderThickness="1"
                                        BorderBrush="{Binding RarityForeground}"
                                        Background="{Binding RarityBackground}">
                                    <Grid>
                                        <Image Margin="6"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding Icon}" />
                                        <wpf:MaterialIcon Width="28"
                                                          Height="28"
                                                          Kind="ShieldOutline"
                                                          Opacity="0.6"
                                                          Foreground="{Binding RarityForeground}">
                                            <!-- Placeholder while the base has no icon. -->
                                            <wpf:MaterialIcon.Style>
                                                <Style TargetType="wpf:MaterialIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </wpf:MaterialIcon.Style>
                                        </wpf:MaterialIcon>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontSize="18"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding RarityForeground}"
                                               Text="{Binding ItemName}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="{Binding Subtitle}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="{Binding LevelText}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource WarningForegroundBrush}"
                                               Text="{Binding ClassWarningText}"
                                               Visibility="{Binding IsSelectedBaseForOtherClass, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Implicits of the selected base, one slider each. -->
                        <ScrollViewer Grid.Row="1" Padding="16,12" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <TextBlock Style="{StaticResource EmptyPageTextStyle}"
                                           Text="{Binding EmptyStatsText}"
                                           Visibility="{Binding HasSelectedBase, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                <StackPanel Visibility="{Binding HasSelectedBase, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Margin="0,0,0,8" Text="Implicit stats" Style="{StaticResource SectionHeaderTextStyle}" />
                                    <!-- base.db from before stat names were stored: names read "Property 10". -->
                                    <Border Margin="0,0,0,12"
                                            Padding="10,6"
                                            CornerRadius="4"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource WarningForegroundBrush}"
                                            Visibility="{Binding IsDatabaseOutdated, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningForegroundBrush}"
                                                   Text="Stat names are missing because the game database is out of date. Update it with the database button in the title bar, then reopen the builder." />
                                    </Border>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}"
                                               Text="No implicit stats."
                                               Visibility="{Binding HasStats, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                    <ItemsControl ItemsSource="{Binding Stats}"
                                                  ItemTemplate="{StaticResource StatTemplate}"
                                                  Focusable="False" />

                                    <!-- Modifiers and effect lines of a unique / set item. -->
                                    <StackPanel Margin="0,8,0,0"
                                                Visibility="{Binding HasUniqueSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Margin="0,0,0,8"
                                                   Foreground="{Binding RarityForeground}"
                                                   Text="{Binding ModStatsHeader}"
                                                   Style="{StaticResource SectionHeaderTextStyle}" />
                                        <ItemsControl ItemsSource="{Binding ModStats}"
                                                      ItemTemplate="{StaticResource StatTemplate}"
                                                      Focusable="False" />
                                        <!-- Effects that do not roll, e.g. "You are immune to Blind and Chill". -->
                                        <ItemsControl ItemsSource="{Binding Effects}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Margin="0,0,0,6"
                                                               FontStyle="Italic"
                                                               TextWrapping="Wrap"
                                                               Foreground="{Binding DataContext.RarityForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Bases of the slot -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ListHeader}" Style="{StaticResource SectionHeaderTextStyle}" />
                        <CheckBox DockPanel.Dock="Right"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Foreground="{DynamicResource SecondaryForegroundBrush}"
                                  IsEnabled="{Binding IsDatabaseAvailable}"
                                  Content="{Binding OnlyUsableText}"
                                  ToolTip="Hide bases this character's class cannot equip"
                                  IsChecked="{Binding ShowOnlyUsable}" />
                    </DockPanel>

                    <TextBox Grid.Row="1"
                             Margin="0,0,0,8"
                             Padding="6,4"
                             IsEnabled="{Binding IsDatabaseAvailable}"
                             ToolTip="Filter by name, type or class"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <Border Grid.Row="2"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource ControlBackgroundBrush}">
                        <Grid>
                            <!-- Item cards, grouped by class and wrapping into as many columns as fit. -->
                            <ListBox ItemsSource="{Binding Source={StaticResource GroupedBases}}"
                                     SelectedItem="{Binding SelectedBaseOption}"
                                     Style="{StaticResource PlainListBoxStyle}"
                                     ItemContainerStyle="{StaticResource ItemCardStyle}"
                                     Padding="6,2,6,6">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="6,12,8,4"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           Text="{Binding Name}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                        <GroupStyle.Panel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </GroupStyle.Panel>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <!-- Card laid out like the game's item tooltip. -->
                                    <DataTemplate DataType="{x:Type inventoryVm:BaseOptionViewModel}">
                                        <Grid x:Name="Card" ToolTip="{Binding ToolTip}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Image Grid.Row="0"
                                                   Grid.Column="0"
                                                   Width="56"
                                                   MaxHeight="96"
                                                   VerticalAlignment="Top"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding Icon}" />

                                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock FontSize="14"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"
                                                           Foreground="{Binding DataContext.RarityForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           Text="{Binding Title}" />
                                                <TextBlock Margin="0,1,0,6"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           Text="{Binding TypeLine}" />
                                                <ItemsControl ItemsSource="{Binding StatLines}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0,0,0,2" FontSize="12" TextWrapping="Wrap" Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding Effects}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Margin="0,2,0,0"
                                                                       FontSize="11"
                                                                       FontStyle="Italic"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{Binding DataContext.RarityForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>

                                            <!-- Requirements, bottom right like the game. -->
                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" HorizontalAlignment="Right">
                                                <TextBlock HorizontalAlignment="Right"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding LevelText}"
                                                           Visibility="{Binding HasLevelRequirement, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <TextBlock HorizontalAlignment="Right"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding ClassText}"
                                                           Visibility="{Binding HasClassRequirement, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!-- Other classes' items stay selectable but are dimmed. -->
                                            <DataTrigger Binding="{Binding IsUsable}" Value="False">
                                                <Setter TargetName="Card" Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Margin="12"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Style="{StaticResource EmptyPageTextStyle}"
                                       Text="{Binding EmptyBasesText}"
                                       Visibility="{Binding HasBases, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="3"
                    Padding="20,12"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButtonStyle}"
                            Content="_Apply"
                            IsDefault="True"
                            Command="{Binding ApplyCommand}" />
                    <Button Margin="8,0,0,0"
                            Style="{StaticResource DialogButtonStyle}"
                            Content="_Cancel"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
