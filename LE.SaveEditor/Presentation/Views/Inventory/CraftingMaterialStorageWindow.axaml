<views:ChromeWindow x:Class="LE.SaveEditor.Presentation.Views.Inventory.CraftingMaterialStorageWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:LE.SaveEditor.Presentation.Views"
        xmlns:mi="using:LE.SaveEditor.Presentation.Controls"
        xmlns:behaviors="using:LE.SaveEditor.Presentation.Behaviors"
        xmlns:inventoryVm="using:LE.SaveEditor.Presentation.ViewModels.Inventory"
        x:DataType="inventoryVm:CraftingMaterialStorageViewModel"
        Title="{Binding Title}"
        Width="500"
        Height="620"
        MinWidth="400"
        MinHeight="420"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Classes="titlebar" Background="{DynamicResource TitleBarBackgroundBrush}">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding Title}" />
                <Button HorizontalAlignment="Right"
                        Theme="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip.Tip="Close"
                        Click="OnCancelClick">
                    <mi:MaterialIcon Width="14" Height="14" Kind="WindowClose" />
                </Button>
            </Grid>

            <!-- ===== Search, materials with their amounts, add ===== -->
            <Grid Grid.Row="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="2,0,0,8"
                           Theme="{StaticResource SecondaryTextStyle}"
                           Text="{Binding StashName, StringFormat='Stash file: {0}'}" />

                <TextBox Grid.Row="1"
                         Margin="0,0,0,8"
                         Padding="6,3"
                         ToolTip.Tip="Search by name"
                         Text="{Binding SearchText}" />

                <Border Grid.Row="2"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        Background="{DynamicResource TitleBarBackgroundBrush}">
                    <Grid>
                        <ListBox x:Name="EntryList"
                                 Margin="0,4"
                                 ItemsSource="{Binding EntriesView}"
                                 SelectedItem="{Binding SelectedEntry}"
                                 Theme="{StaticResource PlainListBoxStyle}"
                                 ItemContainerTheme="{StaticResource ListRowItemStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="inventoryVm:CraftingMaterialAmountViewModel">
                                    <Grid ToolTip.Tip="{Binding ToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Width="28"
                                               Height="28"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapInterpolationMode="HighQuality"
                                               Source="{Binding Icon}" />
                                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                            <TextBlock FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Theme="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding Details}"
                                                       IsVisible="{Binding HasDetails}" />
                                        </StackPanel>
                                        <!-- Amount: digits only, Up / Down change it by one. -->
                                        <TextBox Grid.Column="2"
                                                 Width="72"
                                                 Padding="6,3"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Right"
                                                 ToolTip.Tip="Amount (0 removes the material when applied)"
                                                 behaviors:NumericInput.IsEnabled="True"
                                                 behaviors:NumericInput.Maximum="{x:Static inventoryVm:CraftingMaterialStorageViewModel.MaxQuantity}"
                                                 Text="{Binding Quantity, TargetNullValue=0}" />
                                        <Button Grid.Column="3"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Theme="{StaticResource SubtleIconButtonStyle}"
                                                ToolTip.Tip="Remove from the storage"
                                                Command="{Binding $parent[Window].((inventoryVm:CraftingMaterialStorageViewModel)DataContext).RemoveCommand}"
                                                CommandParameter="{Binding}">
                                            <mi:MaterialIcon Width="16" Height="16" Kind="DeleteOutline" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="16,24"
                                   VerticalAlignment="Top"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Theme="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding EmptyText}"
                                   IsVisible="{Binding !HasEntries}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock VerticalAlignment="Center"
                               Theme="{StaticResource SecondaryTextStyle}"
                               Text="{Binding Summary}" />
                    <Button HorizontalAlignment="Right"
                            Theme="{StaticResource TextLinkButtonStyle}"
                            Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <mi:MaterialIcon Width="14"
                                              Height="14"
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center"
                                              Kind="Plus" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding AddText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2"
                    Padding="16,12"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock MaxWidth="240"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Theme="{StaticResource SecondaryTextStyle}"
                               Text="Written to the stash file when you save." />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Theme="{StaticResource AccentButtonStyle}"
                                Content="Apply"
                                IsDefault="True"
                                Command="{Binding ApplyCommand}" />
                        <Button Margin="8,0,0,0"
                                Theme="{StaticResource DialogButtonStyle}"
                                Content="Cancel"
                                IsCancel="True"
                                Click="OnCancelClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</views:ChromeWindow>
