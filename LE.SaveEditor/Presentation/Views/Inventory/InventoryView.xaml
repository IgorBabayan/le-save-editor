<UserControl x:Class="LE.SaveEditor.Presentation.Views.Inventory.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inventoryVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Inventory"
             xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:behaviors="clr-namespace:LE.SaveEditor.Presentation.Behaviors"
             xmlns:blessingsViews="clr-namespace:LE.SaveEditor.Presentation.Views.Blessings"
             xmlns:factionsViews="clr-namespace:LE.SaveEditor.Presentation.Views.Factions"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=inventoryVm:InventoryViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="800" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Refracted idol slots of an idol altar: the same in every theme, like the rarity colors. -->
        <SolidColorBrush x:Key="RefractedBorderBrush" Color="#4FC3F7" />
        <SolidColorBrush x:Key="RefractedFillBrush" Color="#334FC3F7" />

        <!-- An item of a grid (backpack, idol grid), placed over the cells of its footprint. -->
        <Style x:Key="GridItemContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Grid.Column" Value="{Binding Column}" />
            <Setter Property="Grid.Row" Value="{Binding Row}" />
            <Setter Property="Grid.ColumnSpan" Value="{Binding Width}" />
            <Setter Property="Grid.RowSpan" Value="{Binding Height}" />
        </Style>

        <!-- Tile of a crafting material in the backpack: its icon, or the initials of its name without one. -->
        <Style x:Key="CraftingMaterialButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Image Margin="4"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding MaterialIcon}"
                                       Visibility="{Binding HasMaterialIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Text="{Binding MaterialShortLabel}"
                                           Visibility="{Binding HasMaterialIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GridItemTemplate" DataType="{x:Type inventoryVm:BackpackItemViewModel}">
            <Grid x:Name="ItemRoot">
                <!-- Equipment and idols the editor can decode: same tile as an equipment slot.
                     The wrapper carries the visibility, the button binds to the slot. -->
                <Grid Visibility="{Binding IsEquipment, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Margin="2"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding Equipment}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>

                <!-- Runes, glyphs, affix shards and resources: their icon; a click opens the crafting material picker. -->
                <Grid Visibility="{Binding IsMaterial, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Margin="2"
                            Style="{StaticResource CraftingMaterialButtonStyle}"
                            Command="{Binding DataContext.EditCraftingMaterialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <!-- Tooltip: name, kind and what the material does. -->
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="320">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding MaterialName}" />
                                    <TextBlock FontSize="11"
                                               Style="{StaticResource SecondaryTextStyle}"
                                               Text="{Binding MaterialKindName}" />
                                    <TextBlock Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Text="{Binding MaterialDescription}"
                                               Visibility="{Binding HasMaterialDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </Grid>

                <!-- An idol over a refracted slot of the idol altar gets a refracted frame. -->
                <Border Margin="1"
                        CornerRadius="7"
                        BorderThickness="2"
                        BorderBrush="{StaticResource RefractedBorderBrush}"
                        IsHitTestVisible="False"
                        SnapsToDevicePixels="True"
                        Visibility="{Binding IsInRefractedSlot, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Items, idols or materials missing from base.db keep their cells taken. -->
                <Border Margin="2"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource WindowBorderBrush}"
                        Background="{DynamicResource ControlBackgroundBrush}"
                        SnapsToDevicePixels="True"
                        ToolTip="{Binding PlaceholderToolTip}"
                        Visibility="{Binding IsPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Opacity="0.7"
                               Foreground="{DynamicResource SecondaryForegroundBrush}"
                               Text="{Binding PlaceholderLabel}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <!-- The item stays in its cells, dimmed, until it is dropped. -->
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter TargetName="ItemRoot" Property="Opacity" Value="0.4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== Resources section ===== -->

        <!-- One resource (or woven echo): its icon (dimmed while the stash holds none) and, in a strip below it, its amount
             to type in. -->
        <DataTemplate x:Key="ResourceSlotTemplate" DataType="{x:Type inventoryVm:ResourceSlotViewModel}">
            <Border x:Name="Bd"
                    Width="68"
                    Height="84"
                    Margin="4"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    SnapsToDevicePixels="True"
                    ToolTipService.ShowDuration="30000">
                <Border.ToolTip>
                    <ToolTip>
                        <TextBlock MaxWidth="320" TextWrapping="Wrap" Text="{Binding ToolTip}" />
                    </ToolTip>
                </Border.ToolTip>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Image x:Name="Icon"
                           Grid.Row="0"
                           Margin="8,6,8,4"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Icon}"
                           Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock x:Name="Initials"
                               Grid.Row="0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding Initials}"
                               Visibility="{Binding HasIcon, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    <TextBox Grid.Row="1"
                             MinHeight="0"
                             Margin="3,0,3,3"
                             Padding="2,1"
                             HorizontalAlignment="Stretch"
                             TextAlignment="Center"
                             FontSize="12"
                             FontWeight="SemiBold"
                             BorderThickness="0"
                             Background="{DynamicResource TitleBarBackgroundBrush}"
                             IsReadOnly="{Binding IsEditable, Converter={StaticResource InverseBooleanConverter}}"
                             ToolTip="{Binding AmountToolTip}"
                             behaviors:NumericInput.IsEnabled="True"
                             behaviors:NumericInput.Maximum="{x:Static inventoryVm:CraftingMaterialStorageViewModel.MaxQuantity}"
                             behaviors:SelectOnClick.IsEnabled="True"
                             Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                    <Setter TargetName="Icon" Property="Opacity" Value="0.35" />
                    <Setter TargetName="Initials" Property="Opacity" Value="0.35" />
                </DataTrigger>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlHoverBorderBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A row (or column) of resource slots. -->
        <Style x:Key="ResourceRowStyle" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ItemTemplate" Value="{StaticResource ResourceSlotTemplate}" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResourceColumnStyle" TargetType="ItemsControl" BasedOn="{StaticResource ResourceRowStyle}">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A panel of the Woven echoes section ("Encounters", "Bosses", ...): rows of echoes, each row centred. -->
        <Style x:Key="WovenEchoRowsStyle" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}" Style="{StaticResource ResourceRowStyle}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Title of a Woven echoes panel, centred above it like in the game. -->
        <Style x:Key="WovenEchoPanelTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- A panel of the Resources section (the game's framed boxes). -->
        <Style x:Key="ResourcePanelStyle" TargetType="Border">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Background" Value="{DynamicResource TitleBarBackgroundBrush}" />
        </Style>

        <!-- Vertical label on the left of a group ("KEYS", "CONSUMABLES"). -->
        <Style x:Key="ResourceGroupLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <RotateTransform Angle="-90" />
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== Main information: equipment (left) | idols + crafting materials (right) ===== -->
            <Grid Grid.Row="0" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ===== Equipment: click a slot to open the item builder for it, right-click to edit or remove its item ===== -->
                <Grid Grid.Column="0"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      MouseRightButtonUp="EquipmentGrid_OnMouseRightButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="144" />
                        <ColumnDefinition Width="112" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="96" />
                        <RowDefinition Height="200" />
                        <RowDefinition Height="64" />
                        <RowDefinition Height="96" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: helmet, amulet -->
                    <Button Grid.Row="0" Grid.Column="1" Width="96"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding Helmet}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Row="0" Grid.Column="2" Width="64" Height="64"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding Amulet}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />

                    <!-- Row 1: weapon, body armour, off-hand -->
                    <Button Grid.Row="1" Grid.Column="0"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding Weapon}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding BodyArmour}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Row="1" Grid.Column="2"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding OffHand}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />

                    <!-- Row 2: ring, belt, ring -->
                    <Button Grid.Row="2" Grid.Column="0" Width="56"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding LeftRing}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Row="2" Grid.Column="1"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding Belt}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Row="2" Grid.Column="2" Width="56"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding RightRing}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />

                    <!-- Row 3: gloves, boots, relic -->
                    <Button Grid.Row="3" Grid.Column="0"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding Gloves}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Row="3" Grid.Column="1"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding Boots}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <Button Grid.Row="3" Grid.Column="2"
                            Style="{StaticResource EquipmentSlotButtonStyle}"
                            DataContext="{Binding Relic}"
                            Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                </Grid>

                <!-- ===== Idols + crafting materials ===== -->
                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                    <TextBlock Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               Text="Idols"
                               Style="{StaticResource SectionHeaderTextStyle}" />

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <!-- Idol altar slot, centred beside the idol grid: its altar gives the grid its shape and refracted slots.
                             Click to build or edit the altar, right-click to edit or remove it. -->
                        <StackPanel Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    MouseRightButtonUp="EquipmentGrid_OnMouseRightButtonUp">
                            <Button Width="96" Height="96" Margin="0"
                                    Style="{StaticResource EquipmentSlotButtonStyle}"
                                    DataContext="{Binding IdolAltar}"
                                    Command="{Binding DataContext.OpenItemBuilderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>

                        <!-- Idol grid: 5 × 5 cells shaped by the idol altar (without one: no corners and centre, slots still
                             locked in game show a lock); refracted slots of the altar are highlighted.
                             60 px pitch, matching the item layer.
                             Click an idol to edit it, drag it to move it, right-click an empty cell to build a new one. -->
                        <Border Padding="6"
                                HorizontalAlignment="Center"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource TitleBarBackgroundBrush}">
                            <Grid DataContext="{Binding Idols}">
                                <ItemsControl x:Name="IdolCells"
                                              ItemsSource="{Binding Cells}"
                                              Focusable="False"
                                              IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="{x:Static inventoryVm:InventoryViewModel.IdolGridSize}"
                                                         Columns="{x:Static inventoryVm:InventoryViewModel.IdolGridSize}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type inventoryVm:BackpackCellViewModel}">
                                            <Border x:Name="Cell"
                                                    Width="56"
                                                    Height="56"
                                                    Margin="2"
                                                    CornerRadius="4"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                                    Background="{DynamicResource ControlBackgroundBrush}"
                                                    SnapsToDevicePixels="True">
                                                <TextBlock x:Name="LockGlyph"
                                                           Visibility="Collapsed"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource IconFont}"
                                                           FontSize="20"
                                                           Opacity="0.6"
                                                           Foreground="{DynamicResource ControlBorderBrush}"
                                                           Text="&#xE72E;" />
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <!-- Refracted slots of the idol altar modify the effects of the idols in them. -->
                                                <DataTrigger Binding="{Binding IsRefracted}" Value="True">
                                                    <Setter TargetName="Cell" Property="Background" Value="{StaticResource RefractedFillBrush}" />
                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource RefractedBorderBrush}" />
                                                    <Setter TargetName="Cell" Property="BorderThickness" Value="2" />
                                                </DataTrigger>
                                                <!-- Blocked cells (corners and centre, or the gaps of the altar) can never hold an idol. -->
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter TargetName="Cell" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
                                                    <Setter TargetName="Cell" Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                                <!-- Locked slots: not unlocked in game yet, so no idol goes there. -->
                                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                    <Setter TargetName="Cell" Property="Background" Value="{DynamicResource TitleBarBackgroundBrush}" />
                                                    <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}" />
                                                    <Setter TargetName="LockGlyph" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Idols, each spanning the cells of its footprint; dragged and built like backpack items. -->
                                <ItemsControl x:Name="IdolItems"
                                              ItemsSource="{Binding Items}"
                                              Background="Transparent"
                                              Focusable="False"
                                              ItemContainerStyle="{StaticResource GridItemContainerStyle}"
                                              ItemTemplate="{StaticResource GridItemTemplate}"
                                              PreviewMouseLeftButtonDown="GridItems_OnPreviewMouseLeftButtonDown"
                                              PreviewMouseMove="GridItems_OnPreviewMouseMove"
                                              PreviewMouseLeftButtonUp="GridItems_OnPreviewMouseLeftButtonUp"
                                              MouseRightButtonUp="GridItems_OnMouseRightButtonUp"
                                              LostMouseCapture="GridItems_OnLostMouseCapture">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="60" />
                                                    <RowDefinition Height="60" />
                                                    <RowDefinition Height="60" />
                                                    <RowDefinition Height="60" />
                                                    <RowDefinition Height="60" />
                                                </Grid.RowDefinitions>
                                            </Grid>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!-- Cells the dragged idol would take: green when it fits there, red otherwise. -->
                                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                    <Border x:Name="IdolDropPreview"
                                            Visibility="Collapsed"
                                            CornerRadius="6"
                                            BorderThickness="2"
                                            SnapsToDevicePixels="True" />
                                </Canvas>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <TextBlock Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Opacity="0.7"
                               DataContext="{Binding Idols}"
                               Text="{Binding Summary}"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock HorizontalAlignment="Center"
                               Opacity="0.7"
                               Text="{Binding IdolSlotsText}"
                               Style="{StaticResource SecondaryTextStyle}" />
                    <TextBlock HorizontalAlignment="Center"
                               Opacity="0.85"
                               Foreground="{StaticResource RefractedBorderBrush}"
                               Text="Highlighted slots are refracted: they modify the effects of the idols in them."
                               Visibility="{Binding Idols.HasRefractedCells, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock HorizontalAlignment="Center"
                               Opacity="0.7"
                               Text="Right-click an empty cell to build an idol, or an idol to remove it."
                               Style="{StaticResource SecondaryTextStyle}" />

                    <!-- Crafting materials -->
                    <Border Margin="0,16,0,0"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource TitleBarBackgroundBrush}">
                        <StackPanel>
                            <Border Padding="12,6"
                                    CornerRadius="6,6,0,0"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    Background="{DynamicResource ControlBackgroundBrush}">
                                <TextBlock HorizontalAlignment="Center"
                                           Text="Crafting materials"
                                           Style="{StaticResource SectionHeaderTextStyle}" />
                            </Border>

                            <ItemsControl Margin="8,10" ItemsSource="{Binding CraftingMaterials}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <!-- One kind: its name, how many the material storage holds and its own edit action. -->
                                    <DataTemplate DataType="{x:Type inventoryVm:CraftingMaterialViewModel}">
                                        <StackPanel Margin="4,0" HorizontalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       Text="{Binding Name}"
                                                       Style="{StaticResource SecondaryTextStyle}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       ToolTip="In the material storage"
                                                       Text="{Binding Amount, StringFormat='{}{0:N0}', TargetNullValue='—'}" />
                                            <Button Margin="0,6,0,0"
                                                    HorizontalAlignment="Center"
                                                    Style="{StaticResource TextLinkButtonStyle}"
                                                    ToolTip="{Binding EditToolTip}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    Command="{Binding DataContext.EditCraftingMaterialsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal">
                                                    <wpf:MaterialIcon Width="14"
                                                                      Height="14"
                                                                      Margin="0,0,4,0"
                                                                      VerticalAlignment="Center"
                                                                      Kind="PencilOutline" />
                                                    <TextBlock VerticalAlignment="Center" Text="Edit" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!--
                        Currencies of the stash, in the game's order (favor, ancient bones, gold): typed in, written to the
                        stash file when the character is saved. Favor stays read-only until the stash has a Circle of Fortune entry.
                    -->
                    <Border Margin="0,12,0,0"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Background="{DynamicResource TitleBarBackgroundBrush}">
                        <Border.Resources>
                            <Style x:Key="CurrencyValueTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Margin" Value="0,4,0,0" />
                                <Setter Property="MinWidth" Value="0" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="TextAlignment" Value="Center" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Style.Triggers>
                                    <Trigger Property="IsReadOnly" Value="True">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Resources>
                        <StackPanel>
                            <Border Padding="12,6"
                                    CornerRadius="6,6,0,0"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    Background="{DynamicResource ControlBackgroundBrush}">
                                <TextBlock HorizontalAlignment="Center"
                                           Text="Currencies"
                                           Style="{StaticResource SectionHeaderTextStyle}" />
                            </Border>

                            <Grid Margin="8,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                        Margin="4,0"
                                        Background="Transparent"
                                        ToolTip="{Binding FavorToolTip}"
                                        ToolTipService.ShowOnDisabled="True">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <wpf:MaterialIcon Width="14"
                                                      Height="14"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="#FF9B5DE5"
                                                      Kind="Rhombus" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Favor"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <TextBox IsReadOnly="{Binding HasFavor, Converter={StaticResource InverseBooleanConverter}}"
                                         Style="{StaticResource CurrencyValueTextBoxStyle}"
                                         behaviors:NumericInput.IsEnabled="True"
                                         behaviors:NumericInput.Maximum="{x:Static inventoryVm:StashMaterialsViewModel.MaxFavor}"
                                         behaviors:SelectOnClick.IsEnabled="True"
                                         Text="{Binding Favor, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="4,0"
                                        Background="Transparent"
                                        ToolTip="{Binding AncientBonesToolTip}"
                                        ToolTipService.ShowOnDisabled="True">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <wpf:MaterialIcon Width="14"
                                                      Height="14"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="#FFD8CFC0"
                                                      Kind="Bone" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Bones"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <TextBox IsReadOnly="{Binding HasStash, Converter={StaticResource InverseBooleanConverter}}"
                                         Style="{StaticResource CurrencyValueTextBoxStyle}"
                                         behaviors:NumericInput.IsEnabled="True"
                                         behaviors:NumericInput.Maximum="{x:Static inventoryVm:StashMaterialsViewModel.MaxAncientBones}"
                                         behaviors:SelectOnClick.IsEnabled="True"
                                         Text="{Binding AncientBones, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2"
                                        Margin="4,0"
                                        Background="Transparent"
                                        ToolTip="{Binding GoldToolTip}"
                                        ToolTipService.ShowOnDisabled="True">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <wpf:MaterialIcon Width="14"
                                                      Height="14"
                                                      Margin="0,0,4,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="#FFD4A72C"
                                                      Kind="CircleMultiple" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="Gold"
                                               Style="{StaticResource SecondaryTextStyle}" />
                                </StackPanel>
                                <TextBox IsReadOnly="{Binding HasStash, Converter={StaticResource InverseBooleanConverter}}"
                                         Style="{StaticResource CurrencyValueTextBoxStyle}"
                                         behaviors:NumericInput.IsEnabled="True"
                                         behaviors:NumericInput.Maximum="{x:Static inventoryVm:StashMaterialsViewModel.MaxGold}"
                                         behaviors:SelectOnClick.IsEnabled="True"
                                         Text="{Binding Gold, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0}" />
                            </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Sections: backpack ("Items"), resources (keys and consumables of the stash), woven echoes (of the stash), blessings, factions ===== -->
            <TabControl Grid.Row="1"
                        Margin="0,24,0,0"
                        Padding="0,12,0,0"
                        Style="{StaticResource PillTabControlStyle}">
                <!-- ===== Backpack: 14 × 8 cells; items cover several cells, equipment opens the inspector ===== -->
                <TabItem Header="Items">
                    <StackPanel HorizontalAlignment="Left" DataContext="{Binding Backpack}">
                        <Border Padding="6"
                                HorizontalAlignment="Left"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource TitleBarBackgroundBrush}">
                            <Grid>
                                <!-- Background cells (one 50 px pitch per cell, matching the item layer below). -->
                                <ItemsControl x:Name="BackpackCells" ItemsSource="{Binding Cells}" Focusable="False" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="{x:Static inventoryVm:BackpackViewModel.Rows}"
                                                         Columns="{x:Static inventoryVm:BackpackViewModel.Columns}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type inventoryVm:BackpackCellViewModel}">
                                            <Border Width="48"
                                                    Height="48"
                                                    Margin="1"
                                                    CornerRadius="3"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                                    Background="{DynamicResource ControlBackgroundBrush}"
                                                    SnapsToDevicePixels="True" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Items, each spanning the cells of its footprint. Items are dragged with the mouse
                                     inside the grid only (code-behind); a click without moving opens the inspector.
                                     The transparent background lets empty cells take a right-click (new item). -->
                                <ItemsControl x:Name="BackpackItems"
                                              ItemsSource="{Binding Items}"
                                              Background="Transparent"
                                              Focusable="False"
                                              ItemContainerStyle="{StaticResource GridItemContainerStyle}"
                                              ItemTemplate="{StaticResource GridItemTemplate}"
                                              PreviewMouseLeftButtonDown="GridItems_OnPreviewMouseLeftButtonDown"
                                              PreviewMouseMove="GridItems_OnPreviewMouseMove"
                                              PreviewMouseLeftButtonUp="GridItems_OnPreviewMouseLeftButtonUp"
                                              MouseRightButtonUp="GridItems_OnMouseRightButtonUp"
                                              LostMouseCapture="GridItems_OnLostMouseCapture">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="50" />
                                                    <RowDefinition Height="50" />
                                                    <RowDefinition Height="50" />
                                                    <RowDefinition Height="50" />
                                                    <RowDefinition Height="50" />
                                                    <RowDefinition Height="50" />
                                                    <RowDefinition Height="50" />
                                                    <RowDefinition Height="50" />
                                                </Grid.RowDefinitions>
                                            </Grid>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!-- Cells the dragged item would take: green when it fits there, red otherwise. -->
                                <Canvas IsHitTestVisible="False" ClipToBounds="True">
                                    <Border x:Name="DropPreview"
                                            Visibility="Collapsed"
                                            CornerRadius="6"
                                            BorderThickness="2"
                                            SnapsToDevicePixels="True" />
                                </Canvas>
                            </Grid>
                        </Border>

                        <TextBlock Margin="2,8,0,0"
                                   Text="{Binding Summary}"
                                   Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Margin="2,2,0,0"
                                   Opacity="0.7"
                                   Text="Right-click an empty cell to build a new item there, or an item to edit or remove it."
                                   Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </TabItem>

                <!-- ===== Resources: keys and consumables the stash keeps (keysList), laid out like the game's tab.
                     Type an amount into a slot; changes are written to the stash file when the character is saved. ===== -->
                <TabItem Header="Resources">
                    <StackPanel DataContext="{Binding Resources}">
                        <Border Padding="6"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="3*" MinWidth="440" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- ===== Keys ===== -->
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource ResourcePanelStyle}" Padding="0">
                                    <TextBlock Text="KEYS" Style="{StaticResource ResourceGroupLabelStyle}" />
                                </Border>
                                <!-- Harbinger Eye -->
                                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ResourcePanelStyle}">
                                    <ItemsControl ItemsSource="{Binding HarbingerKeys}" Style="{StaticResource ResourceRowStyle}" />
                                </Border>
                                <!-- Dungeon keys, one panel each -->
                                <ItemsControl Grid.Row="1" Grid.Column="1"
                                              Focusable="False"
                                              ItemsSource="{Binding DungeonKeys}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type inventoryVm:ResourceSlotViewModel}">
                                            <Border Style="{StaticResource ResourcePanelStyle}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  Content="{Binding}"
                                                                  ContentTemplate="{StaticResource ResourceSlotTemplate}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Arena keys -->
                                <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Style="{StaticResource ResourcePanelStyle}">
                                    <ItemsControl ItemsSource="{Binding ArenaKeys}" Style="{StaticResource ResourceColumnStyle}" />
                                </Border>

                                <!-- ===== Consumables ===== -->
                                <Border Grid.Row="2" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource ResourcePanelStyle}" Padding="0">
                                    <TextBlock Text="CONSUMABLES" Style="{StaticResource ResourceGroupLabelStyle}" />
                                </Border>
                                <!-- Portal and Scale charms -->
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ResourcePanelStyle}">
                                    <ItemsControl ItemsSource="{Binding Charms}" Style="{StaticResource ResourceRowStyle}" />
                                </Border>
                                <!-- Crystallized Heart and the primordial materials -->
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource ResourcePanelStyle}">
                                    <ItemsControl ItemsSource="{Binding PrimordialMaterials}" Style="{StaticResource ResourceRowStyle}" />
                                </Border>
                                <!-- Temporal Keystones and Timeglass Fragments -->
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ResourcePanelStyle}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Content="{Binding TimelineMaterials[0]}"
                                                      ContentTemplate="{StaticResource ResourceSlotTemplate}" />
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ResourcePanelStyle}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Content="{Binding TimelineMaterials[1]}"
                                                      ContentTemplate="{StaticResource ResourceSlotTemplate}" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Resources the game's tab does not show, while the stash holds some. -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding HasOthers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="2,0,0,4" Text="Other resources in the stash" Style="{StaticResource SecondaryTextStyle}" />
                            <Border Style="{StaticResource ResourcePanelStyle}" Margin="0">
                                <ItemsControl ItemsSource="{Binding Others}" Focusable="False" ItemTemplate="{StaticResource ResourceSlotTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="2,8,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{Binding Summary}" Style="{StaticResource SecondaryTextStyle}" />
                            <Button Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource TextLinkButtonStyle}"
                                    ToolTip="Edit every resource in the stash, or add one from the game database"
                                    Command="{Binding EditAllCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <wpf:MaterialIcon Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center" Kind="PencilOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="Edit all…" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Margin="2,2,0,0"
                                   Opacity="0.7"
                                   Text="Resources are missing from the game database: names and icons show once it is generated or updated (database button in the title bar)."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{Binding IsDatabaseMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </TabItem>

                <!-- ===== Woven echoes: the echoes of the stash's Woven Echoes tab (wovenEchoesList), laid out like that tab. Type an amount into an
                     echo to add it, 0 removes it; changes are written to the stash file when the character is saved. ===== -->
                <TabItem Header="Woven echoes">
                    <StackPanel DataContext="{Binding WovenEchoes}">
                        <!-- Laid out like the game's tab: Encounters on top, Bosses, Crafting and Auras below. -->
                        <Border Padding="6"
                                HorizontalAlignment="Left"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                Background="{DynamicResource ControlBackgroundBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource ResourcePanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="ENCOUNTERS" Style="{StaticResource WovenEchoPanelTitleStyle}" />
                                        <ItemsControl ItemsSource="{Binding Encounters}" Style="{StaticResource WovenEchoRowsStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ResourcePanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="BOSSES" Style="{StaticResource WovenEchoPanelTitleStyle}" />
                                        <ItemsControl ItemsSource="{Binding Bosses}" Style="{StaticResource WovenEchoRowsStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ResourcePanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="CRAFTING" Style="{StaticResource WovenEchoPanelTitleStyle}" />
                                        <ItemsControl ItemsSource="{Binding Crafting}" Style="{StaticResource WovenEchoRowsStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ResourcePanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="AURAS" Style="{StaticResource WovenEchoPanelTitleStyle}" />
                                        <ItemsControl ItemsSource="{Binding Auras}" Style="{StaticResource WovenEchoRowsStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Echoes the game's tab has no slot for (e.g. a Fading Echo, shown as "ERROR" in game), while the stash holds some. -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding HasOthers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="2,0,0,4" Text="Other woven echoes in the stash" Style="{StaticResource SecondaryTextStyle}" />
                            <Border Style="{StaticResource ResourcePanelStyle}" Margin="0">
                                <ItemsControl ItemsSource="{Binding Others}" Focusable="False" ItemTemplate="{StaticResource ResourceSlotTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </Border>
                        </StackPanel>

                        <TextBlock Margin="2,8,0,0" Text="{Binding Summary}" Style="{StaticResource SecondaryTextStyle}" />
                        <TextBlock Margin="2,2,0,0"
                                   Opacity="0.7"
                                   Text="No character of this stash has unlocked the Woven Echoes tab in game yet: the game shows these echoes once it is unlocked."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{Binding IsTabLocked, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="2,2,0,0"
                                   Opacity="0.7"
                                   Text="Woven echoes are missing from the game database: names and icons show once it is generated or updated (database button in the title bar)."
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Visibility="{Binding IsDatabaseMissing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </TabItem>

                <!-- ===== Blessings: one per timeline echo, picked from the blessings the timeline grants ===== -->
                <TabItem Header="Blessings">
                    <blessingsViews:BlessingsView DataContext="{Binding Blessings}" />
                </TabItem>

                <!-- ===== Factions: rank of every faction unlocked in the stash ===== -->
                <TabItem Header="Factions">
                    <factionsViews:FactionsView DataContext="{Binding Factions}" />
                </TabItem>
            </TabControl>
        </Grid>
    </ScrollViewer>
</UserControl>
