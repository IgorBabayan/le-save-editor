<Window x:Class="LE.SaveEditor.Presentation.Views.Inventory.CraftingMaterialStorageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wpf="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:behaviors="clr-namespace:LE.SaveEditor.Presentation.Behaviors"
        xmlns:inventoryVm="clr-namespace:LE.SaveEditor.Presentation.ViewModels.Inventory"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=inventoryVm:CraftingMaterialStorageViewModel, IsDesignTimeCreatable=False}"
        Title="{Binding Title}"
        Width="500"
        Height="620"
        MinWidth="400"
        MinHeight="420"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32"
                            ResizeBorderThickness="4"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBackgroundBrush}">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding Title}" />
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip="Close"
                        Content="&#xE8BB;"
                        Click="OnCancelClick" />
            </Grid>

            <!-- ===== Search, materials with their amounts, add ===== -->
            <Grid Grid.Row="1" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="2,0,0,8"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="{Binding StashName, StringFormat='Stash file: {0}'}" />

                <TextBox Grid.Row="1"
                         Margin="0,0,0,8"
                         Padding="6,3"
                         ToolTip="Search by name"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <Border Grid.Row="2"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlBorderBrush}"
                        Background="{DynamicResource TitleBarBackgroundBrush}">
                    <Grid>
                        <ListBox x:Name="EntryList"
                                 Margin="0,4"
                                 ItemsSource="{Binding EntriesView}"
                                 SelectedItem="{Binding SelectedEntry}"
                                 IsSynchronizedWithCurrentItem="False"
                                 Style="{StaticResource PlainListBoxStyle}"
                                 ItemContainerStyle="{StaticResource ListRowItemStyle}"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type inventoryVm:CraftingMaterialAmountViewModel}">
                                    <Grid ToolTip="{Binding ToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Image Grid.Column="0"
                                               Width="28"
                                               Height="28"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding Icon}" />
                                        <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                            <TextBlock FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource SecondaryTextStyle}"
                                                       Text="{Binding Details}"
                                                       Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <!-- Amount: digits only, Up / Down change it by one. -->
                                        <TextBox Grid.Column="2"
                                                 Width="72"
                                                 Padding="6,3"
                                                 VerticalAlignment="Center"
                                                 TextAlignment="Right"
                                                 ToolTip="Amount (0 removes the material when applied)"
                                                 behaviors:NumericInput.IsEnabled="True"
                                                 behaviors:NumericInput.Maximum="{x:Static inventoryVm:CraftingMaterialStorageViewModel.MaxQuantity}"
                                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0}" />
                                        <Button Grid.Column="3"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Style="{StaticResource SubtleIconButtonStyle}"
                                                ToolTip="Remove from the storage"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <wpf:MaterialIcon Width="16" Height="16" Kind="DeleteOutline" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Margin="16,24"
                                   VerticalAlignment="Top"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding EmptyText}"
                                   Visibility="{Binding HasEntries, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SecondaryTextStyle}"
                               Text="{Binding Summary}" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource TextLinkButtonStyle}"
                            Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <wpf:MaterialIcon Width="14"
                                              Height="14"
                                              Margin="0,0,4,0"
                                              VerticalAlignment="Center"
                                              Kind="Plus" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding AddText}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2"
                    Padding="16,12"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock MaxWidth="240"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Style="{StaticResource SecondaryTextStyle}"
                               Text="Written to the stash file when you save." />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="Apply"
                                IsDefault="True"
                                Command="{Binding ApplyCommand}" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource DialogButtonStyle}"
                                Content="Cancel"
                                IsCancel="True"
                                Click="OnCancelClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
