<views:ChromeWindow x:Class="LE.SaveEditor.Presentation.Views.Dialogs.ConfirmationWindow"
                    xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="using:LE.SaveEditor.Presentation.Views"
                    xmlns:mi="using:LE.SaveEditor.Presentation.Controls"
                    Title="Confirm"
                    Width="420"
                    SizeToContent="Height"
                    CanResize="False"
                    ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Foreground="{DynamicResource WindowForegroundBrush}">

    <Border BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1">
        <Grid RowDefinitions="32,*,Auto">

            <!-- ===== Title bar ===== -->
            <Grid Grid.Row="0" Classes="titlebar" Background="{DynamicResource TitleBarBackgroundBrush}">
                <TextBlock Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Text="{Binding $parent[Window].Title}" />
                <!-- Same as "No". -->
                <Button HorizontalAlignment="Right"
                        Theme="{StaticResource CloseCaptionButtonStyle}"
                        ToolTip.Tip="Close"
                        Click="OnNoClick">
                    <mi:MaterialIcon Width="14" Height="14" Kind="WindowClose" />
                </Button>
            </Grid>

            <!-- ===== Message ===== -->
            <Grid Grid.Row="1" Margin="20,20,20,24" ColumnDefinitions="Auto,*">
                <mi:MaterialIcon Grid.Column="0"
                                 Width="24"
                                 Height="24"
                                 Margin="0,0,12,0"
                                 VerticalAlignment="Top"
                                 Kind="HelpCircleOutline"
                                 Foreground="{DynamicResource AccentBrush}" />
                <TextBlock x:Name="MessageText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>

            <!-- ===== Footer ===== -->
            <Border Grid.Row="2"
                    Padding="20,12"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource WindowBorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Theme="{StaticResource AccentButtonStyle}"
                            Content="_Yes"
                            IsDefault="True"
                            Click="OnYesClick" />
                    <!-- IsCancel: Escape also answers "No". -->
                    <Button Margin="8,0,0,0"
                            Theme="{StaticResource DialogButtonStyle}"
                            Content="_No"
                            IsCancel="True"
                            Click="OnNoClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</views:ChromeWindow>
