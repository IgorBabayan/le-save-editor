<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <ApplicationIcon>App.ico</ApplicationIcon>
        <!-- Major.Minor for releases; CI appends the build number as the patch part. -->
        <VersionPrefix>0.1.0</VersionPrefix>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
      <PackageReference Include="Material.Icons" Version="3.0.3-nightly.0.2" />
      <PackageReference Include="Material.Icons.WPF" Version="3.0.3-nightly.0.2" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.2.26504.105" />
      <!-- Read-only access to base.db (item bases for the item builder); same SQLite as LE.SaveEditor.DB. -->
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="Presentation\Views\MainWindow.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

    <!--
        LE.SaveEditor.DB runs as a separate, hidden process from Tools\LE.SaveEditor.DB (see Services\GameData\DatabaseGenerator.cs).
        Its own folder keeps its dependencies (EF Core, SkiaSharp) apart from the editor's.
        Local builds copy its build output there; releases publish it there (.github/workflows/release-installer.yml).
    -->
    <PropertyGroup>
        <DatabaseGeneratorProject>$(MSBuildThisFileDirectory)..\LE.SaveEditor.DB\LE.SaveEditor.DB.csproj</DatabaseGeneratorProject>
        <DatabaseGeneratorOutputDir>Tools\LE.SaveEditor.DB\</DatabaseGeneratorOutputDir>
    </PropertyGroup>

    <Target Name="CopyDatabaseGenerator"
            AfterTargets="Build"
            Condition="'$(_IsPublishing)' != 'true' and '$(DesignTimeBuild)' != 'true' and Exists('$(DatabaseGeneratorProject)')">
        <MSBuild Projects="$(DatabaseGeneratorProject)"
                 Targets="Build"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
            <Output TaskParameter="TargetOutputs" ItemName="_DatabaseGeneratorTarget" />
        </MSBuild>

        <PropertyGroup>
            <_DatabaseGeneratorBuildDir>@(_DatabaseGeneratorTarget->'%(RootDir)%(Directory)'->Distinct())</_DatabaseGeneratorBuildDir>
        </PropertyGroup>

        <ItemGroup>
            <_DatabaseGeneratorFiles Include="$(_DatabaseGeneratorBuildDir)**\*" />
        </ItemGroup>

        <Copy SourceFiles="@(_DatabaseGeneratorFiles)"
              DestinationFiles="@(_DatabaseGeneratorFiles->'$(OutDir)$(DatabaseGeneratorOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
